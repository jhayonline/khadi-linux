#!/usr/bin/env bash
# khadi-check — render every theme and validate the output.
#
# PLAN.md section 11 names rolling-release theme breakage as a standing risk:
# any upstream can change its config format with no notice, and ten apps means
# ten chances a week. The stated mitigation was "CI that renders every template
# and diffs output on each upstream bump, so breakage is a failing build rather
# than a user report". This is that.
#
#   khadi-check            render every theme, validate with each app's own checker
#   khadi-check --drift    additionally fail if config/ differs from templates/
#   khadi-check --strict   a skipped validator is a failure
#
# Validators are only run for tools that are installed; a missing tool is
# reported as skipped rather than passed, because silence is not success.
# --strict goes one step further and makes the skip fatal, which is what CI
# wants: on a machine that has the tools, "skipped" means the run proved
# nothing and a green build would be a lie.
set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

DRIFT=0; STRICT=0
for arg in "$@"; do
    case "$arg" in
        --drift)  DRIFT=1 ;;
        --strict) STRICT=1 ;;
        *) echo "khadi-check: unknown flag $arg (want: --drift, --strict)" >&2; exit 2 ;;
    esac
done

pass=0; fail=0; skip=0
ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; pass=$((pass+1)); }
no()   { printf '  \033[31m✗\033[0m %s\n' "$*"; fail=$((fail+1)); }
sk()   { if (( STRICT )); then
             printf '  \033[31m✗\033[0m %s (not installed — nothing was validated)\n' "$*"
             fail=$((fail+1))
         else
             printf '  \033[2m–\033[0m %s (not installed)\n' "$*"
             skip=$((skip+1))
         fi }
have() { command -v "$1" >/dev/null 2>&1; }

# The rolling-release canary, and the half of the section 11 mitigation that
# was missing. A package renamed, dropped, or moved out to the AUR is a break
# Khadi cannot fix at install time — the manifest promises official repos only
# — and it should fail a build on the day it happens rather than turn up in
# somebody's install log a week later.
echo "Packages"
if have pacman; then
    miss=0; n=0
    while read -r p; do
        n=$((n+1))
        pacman -Si "$p" >/dev/null 2>&1 \
            || { printf '    not in the official repos: %s\n' "$p"; miss=$((miss+1)); }
    done < <(awk '{sub(/#.*/,"")} NF {print $1}' packages.txt)
    if (( miss == 0 )); then ok "all $n manifest packages resolve"
    else no "$miss of $n manifest packages are gone"; fi
else sk "pacman"; fi
echo

# Everything the compositor config launches has to be something the install
# actually provides -- from a keybind or from exec-once, because both fail the
# same way and the second one fails more quietly.
#
# Two real bugs sat behind this. `Super+B` pointed at chromium for two phases
# while the manifest never mentioned it. And `exec-once = khadi-bar` named a
# binary the installer did not install at all, so a clean install came up with
# no bar and nothing said why. Each half was internally consistent on its own,
# which is exactly why neither was caught.
echo "What the config launches"
miss=0; n=0
while read -r app; do
    [[ -z "$app" ]] && continue
    n=$((n+1))
    grep -qE "^${app}( |$)" packages.txt && continue
    [[ -x "bin/$app" ]] && continue      # a Khadi script, shipped in bin/
    [[ -d "crates/$app" ]] && continue   # a Khadi binary, built from crates/
    # A binary's name is often not its package's: dbus ships
    # dbus-update-activation-environment, glib2 ships gsettings. Ask pacman
    # which package owns it, which also proves the manifest entry really
    # provides the thing the config calls.
    if have pacman; then
        owner=$(pacman -Qoq "$(command -v "$app" 2>/dev/null)" 2>/dev/null | head -1)
        [[ -n "$owner" ]] && grep -qE "^${owner}( |$)" packages.txt && continue
    fi
    printf '    %s is launched by the config, and nothing in packages.txt, bin/ or crates/ provides it\n' "$app"
    miss=$((miss+1))
done < <({ grep -oE '^bind.*exec, *[a-zA-Z0-9._-]+' config/hypr/hyprland.conf 2>/dev/null \
             | sed -E 's/.*exec, *//'
           grep -oE '^exec-once *= *[a-zA-Z0-9._-]+' config/hypr/hyprland.conf 2>/dev/null \
             | sed -E 's/.*= *//'; } | sort -u)
if (( miss == 0 )); then ok "all $n programs the config launches are provided"
else no "$miss of $n programs the config launches are provided by nothing"; fi
echo

# The backend NAMES in the portal config have to match installed .portal
# files, and the one handed FileChooser has to actually implement it. Both
# fail silently otherwise: xdg-desktop-portal picks whatever is available and
# the user gets a different picker, or none, with nothing in any log they
# would think to read.
echo "Portal backends"
PORTALS=/usr/share/xdg-desktop-portal/portals
PCONF=config/xdg-desktop-portal/hyprland-portals.conf
if [[ -d "$PORTALS" ]]; then
    bad=0
    for b in $(grep -v '^[[:space:]]*#' "$PCONF" | sed -nE 's/^[^=]+=//p' | tr ';' '\n' | sort -u); do
        [[ -z "$b" ]] && continue
        [[ -f "$PORTALS/$b.portal" ]] \
            || { printf '    %s is named in the config but %s/%s.portal does not exist\n' \
                 "$b" "$PORTALS" "$b"; bad=$((bad+1)); }
    done
    fc=$(grep -v '^[[:space:]]*#' "$PCONF" | sed -nE 's/^org\.freedesktop\.impl\.portal\.FileChooser=//p')
    if [[ -n "$fc" ]] && [[ -f "$PORTALS/$fc.portal" ]] \
       && ! grep -q 'org\.freedesktop\.impl\.portal\.FileChooser' "$PORTALS/$fc.portal"; then
        printf '    FileChooser is routed to %s, which does not implement it\n' "$fc"
        bad=$((bad+1))
    fi
    if (( bad == 0 )); then ok "every portal backend named exists and implements what it is given"
    else no "$bad portal backend problem(s)"; fi

    # And then ask the portal itself. Every other validator here is the app's
    # own -- foot's, fuzzel's, starship's -- and xdg-desktop-portal is no
    # different: it is the only authority on how it reads its own config.
    #
    # On an ISOLATED bus. dbus-run-session gives it a private session so it
    # cannot collide with, or take over from, the portal the user is running.
    if [[ -x /usr/lib/xdg-desktop-portal ]] && have dbus-run-session; then
        plog=$(dbus-run-session -- env XDG_CONFIG_HOME="$ROOT/config" \
                 XDG_CURRENT_DESKTOP=Hyprland timeout 4 /usr/lib/xdg-desktop-portal -v 2>&1)
        want="Preferred portals for interface 'org.freedesktop.impl.portal.FileChooser': gtk"
        if ! grep -qF "$PCONF" <<<"$plog"; then
            no "the portal did not read $PCONF"
        elif grep -qF "$want" <<<"$plog"; then
            ok "the portal itself routes FileChooser to gtk"
        else
            no "the portal did not route FileChooser to gtk"
            grep -F "Preferred portals" <<<"$plog" | sed 's/^/    /'
        fi
    else sk "xdg-desktop-portal binary"; fi
else sk "xdg-desktop-portal"; fi
echo

echo "Fonts"
# Repo integrity: is every family OBTAINABLE — vendored here, or from a
# package? Whether this particular machine has them installed is the gate's
# question, not the repo's.
if ./bin/khadi-fontcheck --vendored fonts config/khadi/theme.toml >/dev/null 2>&1; then
    ok "every family the theme names is vendored or packaged"
else
    no "a theme font is neither vendored nor available"
    ./bin/khadi-fontcheck --vendored fonts config/khadi/theme.toml 2>&1 | grep '✗' | sed 's/^/    /'
fi
echo

ACTIVE="$(sed -n 's/^name *= *"\(.*\)"/\1/p' config/khadi/theme.toml 2>/dev/null | head -1)"
ACTIVE="${ACTIVE:-tron}"

if (( DRIFT )); then
    echo "Drift"
    if ./bin/khadi-theme build "$ACTIVE" --check >/dev/null 2>&1; then
        ok "config/ matches templates/ for $ACTIVE"
    else
        no "config/ has drifted — run: khadi-theme build $ACTIVE"
    fi
    echo
fi

for theme in themes/*.toml; do
    t="$(basename "$theme" .toml)"
    echo "Theme: $t"
    if ! ./bin/khadi-theme build "$t" >/dev/null 2>&1; then
        no "render failed"; echo; continue
    fi
    ok "renders"

    # Each app's own validator is the only authority on its own format.
    if have foot; then
        foot --check-config -c config/foot/foot.ini >/dev/null 2>&1 \
            && ok "foot" || no "foot rejected its config"
    else sk "foot"; fi

    if have fuzzel; then
        fuzzel --check-config --config=config/fuzzel/fuzzel.ini >/dev/null 2>&1 \
            && ok "fuzzel" || no "fuzzel rejected its config"
    else sk "fuzzel"; fi

    # starship ALWAYS EXITS 0, even on a config it could not parse — it warns
    # on stderr and carries on with its defaults, so a prompt that silently
    # lost its pill looks like a working command. stderr is the exit status
    # here. Verified with two negative controls: an unknown key warns, a
    # malformed file errors, and both leave stderr non-empty.
    if have starship; then
        err="$(STARSHIP_CONFIG="$ROOT/config/khadi/starship.toml" starship prompt 2>&1 >/dev/null)"
        if [[ -z "$err" ]]; then ok "starship"
        else no "starship rejected its config"; printf '    %s\n' "$err"; fi
    else sk "starship"; fi

    python3 - <<'PY' && ok "toml outputs parse" || no "a TOML output is malformed"
import tomllib, sys
for f in ("config/yazi/theme.toml", "config/yazi/yazi.toml",
          "config/helix/config.toml", "config/helix/themes/khadi.toml",
          "config/greetd/config.toml", "config/khadi/theme.toml",
          "config/khadi/starship.toml"):
    try: tomllib.load(open(f, "rb"))
    except Exception as e: print(f"    {f}: {e}"); sys.exit(1)
PY

    # The GUI side. These are what make a browser's file picker work and stop
    # every GTK app coming up blazing white; a typo here fails open and silent.
    python3 - <<'GUICFG' && ok "portal and GTK configs parse" || no "a GUI config is malformed"
import configparser, sys
for f in ("config/xdg-desktop-portal/hyprland-portals.conf",
          "config/gtk-3.0/settings.ini", "config/gtk-4.0/settings.ini"):
    c = configparser.ConfigParser()
    try: c.read(f)
    except Exception as e: print(f"    {f}: {e}"); sys.exit(1)
    if not c.sections(): print(f"    {f}: no sections"); sys.exit(1)
# Both backends, or a file picker that opens nothing. hyprland's portal does
# not implement FileChooser -- measured from the installed .portal files.
c = configparser.ConfigParser()
c.read("config/xdg-desktop-portal/hyprland-portals.conf")
pref = c["preferred"]
if "gtk" not in pref.get("default", "") \
   and "gtk" not in pref.get("org.freedesktop.impl.portal.filechooser", ""):
    print("    FileChooser has no gtk backend")
    sys.exit(1)
GUICFG

    # The one-colour invariant: a theme that declares no ANSI must not leak a
    # hue the palette does not contain. This is the check that caught yazi's
    # 725 Material-coloured icon rules.
    python3 - "$t" <<'PY' && ok "no colours outside the theme" || no "stray colours in output"
import re, sys, tomllib, pathlib
ctx = tomllib.load(open("config/khadi/theme.toml", "rb"))
allowed = {v.lower() for sect in ("palette","ramp","role","terminal","ansi")
           for v in ctx.get(sect, {}).values()
           if isinstance(v, str) and v.startswith("#")}
allowed |= {"#000000", "#ffffff"}
bad = {}
# Comment syntax is PER FORMAT, never guessed. A heuristic that treats any
# line starting with "#" as a comment silently skips every CSS id selector —
# which is exactly where stray colours hide. Caught by a negative control:
# an injected #ff00ff in a GTK stylesheet passed a checker that "worked".
LINE_COMMENT = {".css": None, ".jsonc": "//", ".kdl": "//",
                ".ini": "#", ".conf": "#", ".toml": "#", ".theme": "#"}

def strip_comments(text, suffix):
    # Comments legitimately quote colours — the yazi theme names three of the
    # Material hues it overrides. A checker that reads its own documentation
    # as config reports a defect that is not there.
    if suffix == ".css":
        return re.sub(r"/\*.*?\*/", "", text, flags=re.S)
    marker = LINE_COMMENT.get(suffix)
    if marker is None:
        return text
    out = []
    for line in text.splitlines():
        if line.lstrip().startswith(marker): continue
        out.append(re.sub(rf"\s+{re.escape(marker)}\s.*$", "", line))
    return "\n".join(out)

for f in pathlib.Path("config").rglob("*"):
    if not f.is_file(): continue
    body = strip_comments(f.read_text(errors="ignore"), f.suffix)
    for m in re.findall(r"#[0-9a-fA-F]{6}\b", body):
        if m.lower() not in allowed: bad.setdefault(str(f), set()).add(m)
for f, c in sorted(bad.items()): print(f"    {f}: {', '.join(sorted(c))}")
sys.exit(1 if bad else 0)
PY
    echo
done

./bin/khadi-theme build "$ACTIVE" >/dev/null 2>&1
echo "────────────────────────────────────────────"
printf '  %d passed, %d failed, %d skipped   (restored: %s)\n' "$pass" "$fail" "$skip" "$ACTIVE"
exit $(( fail > 0 ))
