#!/usr/bin/env python3
"""
Khadi — keybinding cheatsheet (Super+/).

Parses the live configs rather than carrying its own copy, so it cannot drift
from what the system actually does. Renders in the Khadi one-row motif
(PLAN.md Phase 0: two-row costs 43% of height, one-row 23%).
"""
import os, re, shutil, sys, tomllib
from pathlib import Path

def roots():
    cfg = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config'))
    repo = Path(__file__).resolve().parent.parent
    return cfg, repo

CFG, REPO = roots()

def find(rel):
    for base in (CFG, REPO / 'config'):
        p = base / rel
        if p.is_file():
            return p
    return None

def theme():
    for p in (CFG / 'khadi' / 'theme.toml', REPO / 'themes' / 'tron.toml'):
        if p.is_file():
            return tomllib.load(open(p, 'rb'))['role']
    return {'text': '#aacfd1', 'text_dim': '#89a7aa',
            'text_muted': '#586c6f', 'rule': '#364448', 'ground': '#05080d'}

R = theme()
def fg(k):
    h = R[k].lstrip('#')
    return '\033[38;2;%d;%d;%dm' % tuple(int(h[i:i+2], 16) for i in (0, 2, 4))
TEXT, DIM, MUTED, RULE = fg('text'), fg('text_dim'), fg('text_muted'), fg('rule')
h = R['ground'].lstrip('#')
BG = '\033[48;2;%d;%d;%dm' % tuple(int(h[i:i+2], 16) for i in (0, 2, 4))
X = '\033[0m'

def _exec_label(arg):
    a = arg.strip()
    if 'zellij' in a:            return 'khadi session (terminal + panes)'
    if 'cheatsheet' in a:         return 'this cheatsheet'
    if a.startswith('foot -e '):  return a.split('-e', 1)[1].strip()
    if a.startswith('foot'):      return 'bare terminal'
    if 'cheatsheet' in a:         return 'this cheatsheet'
    if 'slurp' in a:              return 'screenshot region to clipboard'
    if 'hyprlock' in a:           return 'lock screen'
    return a.split()[0] if a else 'exec'


def collapse(rows):
    """Fold runs that differ only by a trailing digit or direction."""
    out, i = [], 0
    while i < len(rows):
        combo, label = rows[i]
        m = re.match(r'^(.*?)(\d)$', combo)
        grp = []
        if m:
            while i < len(grp and [] or rows) and i < len(rows):
                m2 = re.match(r'^(.*?)(\d)$', rows[i][0])
                if not m2 or m2.group(1) != m.group(1): break
                grp.append(rows[i]); i += 1
            if len(grp) > 1:
                base = m.group(1)
                lo, hi = grp[0][0][-1], grp[-1][0][-1]
                out.append((f'{base}{lo}..{hi}', re.sub(r'\s*\d+$', ' N', grp[0][1])))
                continue
        out.append((combo, label)); i += 1
    return out


def hypr_binds():
    p = find('hypr/hyprland.conf')
    if not p: return []
    out = []
    for ln in p.read_text().splitlines():
        m = re.match(r'\s*bindm?\s*=\s*([^,]*),\s*([^,]+),\s*(\w+)\s*(?:,\s*(.*))?$', ln)
        if not m: continue
        mod, key, act, arg = (x.strip() if x else '' for x in m.groups())
        if 'mouse' in key: continue
        mod = mod.replace('$mod', 'Super').strip()
        combo = f'{mod} + {key}' if mod else key
        combo = re.sub(r'\s+', ' ', combo).replace('Super SHIFT', 'Super+Shift')
        label = {'exec': _exec_label(arg),
                 'killactive': 'close window', 'exit': 'quit Hyprland',
                 'movefocus': f'focus {arg}', 'movewindow': f'move {arg}',
                 'fullscreen': 'fullscreen (dismiss the chrome)',
                 'togglefloating': 'float', 'workspace': f'workspace {arg}',
                 'movetoworkspace': f'send to workspace {arg}'}.get(act, f'{act} {arg}'.strip())
        out.append((combo, label))
    return out

def zellij_binds():
    p = find('zellij/config.kdl')
    if not p: return []
    out = []
    for ln in p.read_text().splitlines():
        m = re.match(r'\s*bind\s+((?:"[^"]+"\s*)+)\{\s*(\w+)\s*(?:"([^"]*)")?', ln)
        if not m: continue
        keys = re.findall(r'"([^"]+)"', m.group(1))
        act, arg = m.group(2), m.group(3) or ''
        label = {'NewPane': f'new pane {arg}'.strip(), 'CloseFocus': 'close pane',
                 'MoveFocus': f'focus {arg}', 'MoveFocusOrTab': f'focus/tab {arg}',
                 'Resize': f'resize {arg}', 'ToggleFocusFullscreen': 'zoom pane',
                 'NewTab': 'new tab', 'CloseTab': 'close tab', 'Quit': 'detach',
                 'TogglePaneFrames': 'toggle frames'}.get(act, f'{act} {arg}'.strip())
        out.append((keys[0], label))
    return out

def foot_binds():
    p = find('foot/foot.ini')
    if not p: return []
    out, on = [], False
    for ln in p.read_text().splitlines():
        if ln.strip().startswith('['):
            on = ln.strip() == '[key-bindings]'; continue
        if on and '=' in ln and not ln.strip().startswith('#'):
            act, combo = (x.strip() for x in ln.split('=', 1))
            out.append((combo.replace('Control', 'Ctrl'), act.replace('-', ' ')))
    return out

def main():
    W = min(shutil.get_terminal_size((80, 30)).columns, 100) - 2
    buf = [f'{BG}']
    def line(s=''): buf.append(f'  {s}{X}{BG}\033[K\n')

    def section(title, right, rows):
        pad = W - len(title) - len(right) - 4
        line(f'{TEXT}{title}{" " * max(pad, 1)}{DIM}{right}')
        line(f'{RULE}┬{"─" * (W - 6)}┬')          # one-row motif
        for combo, label in rows:
            line(f'{TEXT}{combo:<26}{MUTED}{label}')
        line()

    line()
    line(f'{TEXT}KHADI{" " * (W - 22)}{DIM}KEYBINDINGS')
    line(f'{RULE}{"─" * (W - 4)}')
    line()
    line(f'{MUTED}Each layer owns one modifier. Nothing overlaps.')
    line()
    section('COMPOSITOR', 'SUPER', collapse(hypr_binds()))
    section('PANES', 'ALT', zellij_binds())
    section('TERMINAL', 'CTRL+SHIFT', foot_binds())
    line(f'{MUTED}Any key to close.')
    line()
    buf.append(X)
    sys.stdout.write(''.join(buf))
    try:
        import termios, tty
        fd = sys.stdin.fileno(); old = termios.tcgetattr(fd)
        tty.setraw(fd); sys.stdin.read(1); termios.tcsetattr(fd, termios.TCSADRAIN, old)
    except Exception:
        input()

if __name__ == '__main__':
    main()
