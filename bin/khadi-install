#!/usr/bin/env bash
# Khadi — installer. Phase 1.
#
# Links this repo's config/ into ~/.config and bin/ into ~/.local/bin.
#
# DRY RUN BY DEFAULT. Nothing is touched without --apply. Khadi's paths
# collide with any existing Hyprland setup (Omarchy's especially), so every
# target that already exists is backed up before it is replaced, and
# --uninstall puts the backups back.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
: "${XDG_CONFIG_HOME:=$HOME/.config}"
BIN="$HOME/.local/bin"
STAMP="$(date +%Y%m%d-%H%M%S)"
MODE=link
APPLY=0
SYSTEM=0
UNINSTALL=0

usage() {
    cat <<USAGE
khadi-install — link the Khadi config into your home directory

  --apply        actually do it (default is a dry run)
  --copy         copy files instead of symlinking (default: symlink)
  KHADI_THEME=x  build theme x before installing (default: tron)
  --uninstall    remove Khadi links and restore the newest backups
  -h, --help     this

Dry run prints exactly what would change. Existing targets are moved to
<target>.khadi-backup-<timestamp>, never deleted.
USAGE
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --apply) APPLY=1 ;;
        --system) SYSTEM=1 ;;
        --copy) MODE=copy ;;
        --uninstall) UNINSTALL=1 ;;
        -h|--help) usage; exit 0 ;;
        *) echo "khadi-install: unknown option $1" >&2; usage; exit 2 ;;
    esac
    shift
done

say()  { printf '  %s\n' "$*"; }
act()  { if (( APPLY )); then "$@"; fi; }

CONFIGS=(foot zellij btop hypr yazi fuzzel helix mako khadi gtk-3.0 gtk-4.0 xdg-desktop-portal)
BINS=(khadi-cheatsheet khadi-dev khadi-theme khadi-check khadi-fontcheck khadi-boot)
# khadi-shell is the odd one. Tauri embeds its whole frontend into the binary,
# so there is still exactly one file to install and nothing to put beside it —
# but it MUST be built through the Tauri CLI. `cargo build --release` produces
# a khadi-shell that compiles, links, runs, opens a window and then shows
# "Could not connect to localhost: Connection refused", because without the CLI
# the frontend is never embedded and the binary falls back to the dev server.
# It is a silent, plausible-looking failure and it cost a VM boot to find.
#
# The compiled half. khadi-shell is the desktop; khadi-bar is the strip above
# it; khadi-greet is the login screen, which runs on a VT before any of this
# exists and is therefore the one surface still drawn in a terminal.
#
# The installer once shipped NONE of these: a clean --apply produced a desktop
# with no panels and no bar, and the VM gate never caught it because
# `khadi-vm push` installs them separately — so the gate was passing on a state
# the installer could not produce, which is the hole in "someone else runs the
# script and gets your desktop".
RUSTBINS=(khadi-shell khadi-bar khadi-greet)

# ---------------------------------------------------------------- uninstall
if (( UNINSTALL )); then
    echo "Khadi uninstall $( ((APPLY)) || echo '(dry run)' )"
    fd="${XDG_DATA_HOME:-$HOME/.local/share}/fonts/khadi"
    if [[ -L "$fd" ]]; then
        say "unlink  $fd"
        act rm "$fd"
    fi
    for prof in "$HOME/.bash_profile" "$HOME/.bash_login" "$HOME/.profile" \
                "$HOME/.zprofile" "$HOME/.bashrc" "$HOME/.zshrc" \
                "$HOME/.config/fish/conf.d/khadi-path.fish" \
                "$HOME/.config/fish/conf.d/khadi-prompt.fish"; do
        [[ -f "$prof" ]] && grep -qsE '# >>> khadi (path|prompt) >>>' "$prof" || continue
        say "strip   khadi block from $prof"
        act python3 - "$prof" <<'STRIP'
import re, sys
p = sys.argv[1]; s = open(p).read()
# Both blocks, in whichever file they landed in: the PATH block goes to the
# login profile and the prompt block to the interactive rc, and on zsh and
# bash those are different files.
open(p, 'w').write(
    re.sub(r'\n?# >>> khadi (path|prompt) >>>.*?# <<< khadi \1 <<<\n', '', s, flags=re.S))
STRIP
    done
    for c in "${CONFIGS[@]}"; do
        t="$XDG_CONFIG_HOME/$c"
        if [[ -L "$t" && "$(readlink -f "$t")" == "$ROOT/config/$c" ]]; then
            say "unlink  $t"; act rm "$t"
        fi
        b="$(ls -d "$t".khadi-backup-* 2>/dev/null | sort | tail -1 || true)"
        if [[ -n "$b" ]]; then say "restore $b -> $t"; act mv "$b" "$t"; fi
    done
    for b in "${BINS[@]}" "${RUSTBINS[@]}"; do
        t="$BIN/$b"
        [[ -L "$t" ]] && { say "unlink  $t"; act rm "$t"; }
    done
    (( APPLY )) || echo $'\n  Dry run. Re-run with --apply.'
    exit 0
fi

# ---------------------------------------------------------------- packages
echo "Khadi install $( ((APPLY)) || echo '(dry run)' )"
echo
echo "Packages:"
missing=()
while read -r p _; do
    [[ -z "$p" || "$p" == \#* ]] && continue
    if pacman -Qq "$p" >/dev/null 2>&1; then say "✓ $p"
    else say "✗ $p"; missing+=("$p"); fi
done < "$ROOT/packages.txt"

if (( ${#missing[@]} )); then
    echo
    say "Missing ${#missing[@]}. Khadi does not install packages for you —"
    say "run this yourself, then re-run the installer:"
    echo
    say "    sudo pacman -S --needed ${missing[*]}"
fi

# ----------------------------------------------------------------- theme
# Regenerate first: config/ is build output, and linking stale output would
# let the tree drift from templates/ without anyone noticing.
THEME="${KHADI_THEME:-tron}"
echo
echo "Theme ($THEME):"
if (( APPLY )); then
    "$ROOT/bin/khadi-theme" build "$THEME" | sed 's/^/  /'
else
    "$ROOT/bin/khadi-theme" build "$THEME" --check | sed 's/^/  /' || true
fi

# ---------------------------------------------------------------- configs
echo
echo "Config:"
# A fresh user account has no ~/.config. Found by the Phase 1 gate: the
# installer worked on the author's machine purely because the directory
# already existed there.
if [[ ! -d "$XDG_CONFIG_HOME" ]]; then
    say "mkdir  $XDG_CONFIG_HOME"
    act mkdir -p "$XDG_CONFIG_HOME"
fi
for c in "${CONFIGS[@]}"; do
    src="$ROOT/config/$c"
    t="$XDG_CONFIG_HOME/$c"
    [[ -d "$src" ]] || continue
    if [[ -L "$t" && "$(readlink -f "$t")" == "$src" ]]; then
        say "ok      $t (already linked)"
        continue
    fi
    if [[ -e "$t" ]]; then
        say "BACKUP  $t -> $t.khadi-backup-$STAMP"
        act mv "$t" "$t.khadi-backup-$STAMP"
    fi
    if [[ "$MODE" == link ]]; then
        say "link    $t -> $src"
        act ln -s "$src" "$t"
    else
        say "copy    $src -> $t"
        act cp -r "$src" "$t"
    fi
done

# The RESOLVED theme, not the source. khadi-theme writes config/khadi/theme.toml
# with the derived ramp and roles; the source file in themes/ holds inputs only
# and has no `role` section at all. Linking the source was a Phase 1 leftover
# from before the generator existed — it made khadi-hud fail to start.
say "link    $XDG_CONFIG_HOME/khadi -> $ROOT/config/khadi"

# ---------------------------------------------------------------- binaries
echo
echo "Binaries:"
act mkdir -p "$BIN"
for b in "${BINS[@]}"; do
    say "link    $BIN/$b"
    act ln -sf "$ROOT/bin/$b" "$BIN/$b"
done
# Khadi does not build for you, the same way it does not install packages for
# you — it says what is missing and prints the command. Silence here is the
# expensive case: `exec-once = khadi-bar` fails without a word and the session
# just comes up without a bar.
missing_rust=0
for b in "${RUSTBINS[@]}"; do
    if [[ -x "$ROOT/target/release/$b" ]]; then
        say "link    $BIN/$b"
        act ln -sf "$ROOT/target/release/$b" "$BIN/$b"
    else
        say "MISSING $b — not built"
        missing_rust=$((missing_rust+1))
    fi
done
if (( missing_rust )); then
    say ""
    say "  $missing_rust of ${#RUSTBINS[@]} compiled components are not built."
    say "  Without them the layout has no panels and the session has no bar:"
    say "      cargo build --release                      (khadi-bar, khadi-greet)"
    say "      cd shell && npm install && npm run tauri build   (khadi-shell)"
fi

# Arch's /etc/profile adds /usr/local/bin but NOT ~/.local/bin, so in a login
# shell khadi-panel is unfindable and the zellij layout fails to spawn its
# side panels. Found by the Phase 1 gate; a non-interactive ssh shell has the
# path and a login shell does not, so this hides from casual testing.
# Which file a login shell actually reads is shell-specific, and bash ignores
# ~/.profile entirely when ~/.bash_profile exists — which /etc/skel ships on
# Arch. Writing to the wrong one fails silently. Found by the Phase 1 gate.
login_profile() {
    case "$(basename "${SHELL:-/bin/bash}")" in
        zsh)  echo "$HOME/.zprofile" ;;
        fish) echo "$HOME/.config/fish/conf.d/khadi-path.fish" ;;
        *)    if   [[ -f "$HOME/.bash_profile" ]]; then echo "$HOME/.bash_profile"
              elif [[ -f "$HOME/.bash_login"   ]]; then echo "$HOME/.bash_login"
              else echo "$HOME/.profile"; fi ;;
    esac
}
PROFILE="$(login_profile)"
MARK="# >>> khadi path >>>"
if ! grep -qsF "$MARK" "$PROFILE" 2>/dev/null; then
    echo
    echo "PATH:"
    say "append  $PROFILE  (adds $BIN)"
    if (( APPLY )); then
        act mkdir -p "$(dirname "$PROFILE")"
        [[ -e "$PROFILE" ]] && cp "$PROFILE" "$PROFILE.khadi-backup-$STAMP"
        if [[ "$PROFILE" == *.fish ]]; then
            # NOT `return`. This is top-level, not a function, so `return`
            # fails and `set -e` kills the installer right here — a fish user
            # got the PATH block and no fonts, and the script exited 2.
            cat >> "$PROFILE" <<'FISHP'
# >>> khadi path >>>
fish_add_path -g "$HOME/.local/bin"
# <<< khadi path <<<
FISHP
        else
        cat >> "$PROFILE" <<PROF

$MARK
case ":\$PATH:" in
    *":\$HOME/.local/bin:"*) ;;
    *) PATH="\$HOME/.local/bin:\$PATH" ;;
esac
export PATH
# <<< khadi path <<<
PROF
        fi
    fi
fi

# ----------------------------------------------------------------- prompt
# A/B item 13, the prompt pill. starship rather than a shell function because
# Khadi does not own the login shell: a fish-only prompt would be absent for
# most users on the day they install.
#
# This goes in the INTERACTIVE rc, not the login profile the PATH block uses.
# A prompt is interactive-only, and the two files are different ones on every
# shell — .zshrc vs .zprofile, .bashrc vs .bash_profile.
interactive_rc() {
    case "$(basename "${SHELL:-/bin/bash}")" in
        zsh)  echo "$HOME/.zshrc" ;;
        fish) echo "$HOME/.config/fish/conf.d/khadi-prompt.fish" ;;
        *)    echo "$HOME/.bashrc" ;;
    esac
}
RC="$(interactive_rc)"
SH="$(basename "${SHELL:-bash}")"
PMARK="# >>> khadi prompt >>>"
if ! grep -qsF "$PMARK" "$RC" 2>/dev/null; then
    echo
    echo "Prompt:"
    say "append  $RC  (starship, khadi config)"
    command -v starship >/dev/null 2>&1 \
        || say "NOTE    starship is not installed; the block is inert until it is"
    if (( APPLY )); then
        mkdir -p "$(dirname "$RC")"
        [[ -e "$RC" ]] && cp "$RC" "$RC.khadi-backup-$STAMP"
        # The block guards itself. Khadi does not install packages, so
        # starship may be missing now or removed later, and an unguarded init
        # line turns that into an error on every single shell start.
        if [[ "$RC" == *.fish ]]; then
            cat >> "$RC" <<FISHRC
$PMARK
set -gx STARSHIP_CONFIG "$XDG_CONFIG_HOME/khadi/starship.toml"
if type -q starship
    starship init fish | source
end
# <<< khadi prompt <<<
FISHRC
        else
            cat >> "$RC" <<RCB

$PMARK
export STARSHIP_CONFIG="$XDG_CONFIG_HOME/khadi/starship.toml"
command -v starship >/dev/null 2>&1 && eval "\$(starship init $SH)"
# <<< khadi prompt <<<
RCB
        fi
    fi
fi

# ------------------------------------------------------------------ fonts
# Vendored because Rajdhani and Orbitron are not in Arch's official repos and
# a Khadi install cannot depend on the AUR. This runs BEFORE the font check
# below, which is the thing that would have caught a whole phase of rendering
# in Liberation Sans without anyone noticing.
FONTDIR="${XDG_DATA_HOME:-$HOME/.local/share}/fonts/khadi"
echo
echo "Fonts:"
say "link    $FONTDIR -> $ROOT/fonts"
if (( APPLY )); then
    mkdir -p "$(dirname "$FONTDIR")"
    [[ -e "$FONTDIR" && ! -L "$FONTDIR" ]] && mv "$FONTDIR" "$FONTDIR.khadi-backup-$STAMP"
    ln -sfn "$ROOT/fonts" "$FONTDIR"
    if command -v fc-cache >/dev/null 2>&1; then
        fc-cache -f "$ROOT/fonts" >/dev/null 2>&1 && say "fc-cache rebuilt"
    fi
    # A missing font is not an error — fontconfig substitutes silently — so the
    # install verifies rather than assuming.
    if "$ROOT/bin/khadi-fontcheck" "$ROOT/config/khadi/theme.toml" >/dev/null 2>&1; then
        say "all theme fonts resolve"
    else
        say "WARNING: some theme fonts do not resolve — run khadi-fontcheck"
    fi
fi

# ------------------------------------------------------------------ system
if (( SYSTEM )); then
    echo
    echo "System (needs root):"
    say "install $ROOT/config/greetd/config.toml -> /etc/greetd/config.toml"
    say "enable  greetd.service, disable getty autologin on tty1"
    if (( APPLY )); then
        sudo install -Dm644 "$ROOT/config/greetd/config.toml" /etc/greetd/config.toml
        sudo rm -f /etc/systemd/system/getty@tty1.service.d/autologin.conf
        sudo systemctl daemon-reload
        sudo systemctl enable greetd.service >/dev/null 2>&1
        say "greetd enabled — it takes over tty1 on next boot"
    fi

    # The greeter runs as the `greeter` user, which cannot read anyone's home
    # directory. A link into ~/.local/bin is therefore useless to it: both the
    # binary and the theme have to exist somewhere system-wide.
    say "install khadi-greet -> /usr/local/bin/khadi-greet"
    say "install resolved theme -> /etc/khadi/theme.toml"
    if (( APPLY )); then
        if [[ -x "$ROOT/target/release/khadi-greet" ]]; then
            sudo install -Dm755 "$ROOT/target/release/khadi-greet" /usr/local/bin/khadi-greet
        else
            say "WARNING: khadi-greet is not built — the login screen will not start."
            if [[ "$b" == khadi-shell ]]; then
                say "         cd shell && npm install && npm run tauri build, then re-run"
            else
                say "         cargo build --release, then re-run"
            fi
        fi
        sudo install -Dm644 "$ROOT/config/khadi/theme.toml" /etc/khadi/theme.toml
    fi

    # The boot splash. Its own script because it is a lot of steps and worth
    # running alone, but invoked from here so there is ONE root-level entry
    # point rather than two installers to remember.
    echo
    if (( APPLY )); then
        sudo "$ROOT/bin/khadi-boot" --apply
    else
        "$ROOT/bin/khadi-boot"
    fi
fi

echo
if (( APPLY )); then
    say "Done. Log out and back in, or: hyprctl reload"
else
    say "Dry run — nothing changed. Re-run with --apply."
fi
