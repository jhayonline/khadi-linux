#!/usr/bin/env bash
# Khadi — test VM.
#
# A throwaway Arch VM, and the only safe way to test a compositor: khadi-comp
# takes over the display, so running a build on the machine you are working on
# logs you out of it. Deliberately plain QEMU, no libvirt — one
# script, no daemon, nothing installed into the host's system state.
#
#   khadi-vm deps     what you must install (needs root; this script will not)
#   khadi-vm fetch    download + verify the Arch ISO
#   khadi-vm create   make the disk image
#   khadi-vm run      boot it (installer on first run, disk after)
#   khadi-vm stop     graceful power-off via the QMP socket
#   khadi-vm shot     screenshot the guest framebuffer via QMP
#   khadi-vm ssh      shell into the guest once Arch is installed
#   khadi-vm push     copy this repo into the guest
#   khadi-vm autologin start a session on tty1 without going through greetd
#   khadi-vm type     type into the guest console over QMP (drives the greeter)
#   khadi-vm status   what exists so far
#   khadi-vm clean    delete the disk (keeps the ISO)
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
ISO_VER="2026.10.01"
ISO_SHA="684ded26c63240ff4a41e8c25ee84ea6da233f557364821f13d12c2b0a9059a5"
ISO="$HERE/archlinux-$ISO_VER-x86_64.iso"
DISK="$HERE/khadi.qcow2"
NVRAM="$HERE/OVMF_VARS.fd"
QMP="$HERE/.qmp.sock"
MIRROR="https://geo.mirror.pkgbuild.com/iso/$ISO_VER"

RAM="${KHADI_VM_RAM:-4G}"
CPUS="${KHADI_VM_CPUS:-2}"
SIZE="${KHADI_VM_DISK:-24G}"
SSH_PORT="${KHADI_VM_SSH:-2222}"
# QEMU's default guest display is 1024x768, which at Iosevka Term size 10 is
# 153 columns — below the 180 the reference layout needs (PLAN.md section 10).
# The gate would fail on VM configuration rather than on Khadi. Match the host.
XRES="${KHADI_VM_XRES:-1920}"
YRES="${KHADI_VM_YRES:-1080}"
# GL: on by default, KHADI_VM_GL=off falls back to a plain framebuffer.
GL="${KHADI_VM_GL:-on}"
# Headless: no GTK window, framebuffer fixed at XRES x YRES, reachable over
# VNC. The GTK window's size *dictates* the guest resolution — under a tiling
# WM that is whatever the WM assigned (732x810 here, ~109 columns, far under
# the 180 the layout needs). Headless makes resolution reproducible and
# `khadi-vm shot` meaningful, which is what automated gate runs require.
HEADLESS="${KHADI_VM_HEADLESS:-0}"
# Open the window already filling the screen, so the guest picks a mode the
# shell's layout fits in rather than one the window decorations left over.
FULLSCREEN="${KHADI_VM_FULLSCREEN:-0}"
VNC_PORT="${KHADI_VM_VNC:-1}"

die()  { printf '\n  %s\n\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# pgrep -f also matches shells whose command line mentions qemu, and pgrep -x
# cannot match a name over 15 characters. Resolve /proc/PID/exe instead.
vm_pid() {
    local p
    for p in /proc/[0-9]*; do
        [[ "$(readlink "$p/exe" 2>/dev/null)" == */qemu-system-x86_64 ]] || continue
        grep -qa 'khadi-test' "$p/cmdline" 2>/dev/null && { basename "$p"; return 0; }
    done
    return 1
}

cmd_deps() {
    cat <<DEPS

  Khadi's VM needs these. Installing packages requires root, so run it
  yourself:

      sudo pacman -S --needed qemu-desktop edk2-ovmf

  qemu-desktop   the emulator plus a GTK display (qemu-base is headless)
  edk2-ovmf      UEFI firmware — Khadi's real installer assumes UEFI + LUKS,
                 so the VM should boot the same way

  Already present and no action needed:
DEPS
    printf '    %-24s %s\n' "/dev/kvm" "$( [[ -w /dev/kvm ]] && echo 'writable — no group change needed' || echo 'NOT writable' )"
    printf '    %-24s %s\n' "VT-x (vmx)" "$( grep -q vmx /proc/cpuinfo && echo present || echo ABSENT )"
    echo
}

need_qemu() {
    have qemu-system-x86_64 || die "qemu is not installed. Run: khadi-vm deps"
}

cmd_fetch() {
    if [[ -f "$ISO" ]]; then echo "  ISO already here: $ISO"; else
        echo "  Downloading Arch $ISO_VER (about 1.3 GiB)…"
        curl -fL --progress-bar -o "$ISO.part" "$MIRROR/archlinux-$ISO_VER-x86_64.iso"
        mv "$ISO.part" "$ISO"
    fi
    echo "  Verifying sha256…"
    local got; got="$(sha256sum "$ISO" | cut -d' ' -f1)"
    [[ "$got" == "$ISO_SHA" ]] || die "CHECKSUM MISMATCH
    expected $ISO_SHA
    got      $got
  Delete $ISO and try again."
    echo "  ✓ $ISO_VER verified"
}

cmd_create() {
    need_qemu
    [[ -f "$DISK" ]] && die "$DISK already exists. 'khadi-vm clean' first."
    qemu-img create -f qcow2 "$DISK" "$SIZE" >/dev/null
    echo "  ✓ created $DISK ($SIZE, sparse — it only grows as it fills)"
    for f in /usr/share/edk2/x64/OVMF_VARS.4m.fd /usr/share/edk2-ovmf/x64/OVMF_VARS.fd; do
        [[ -f "$f" ]] && { cp "$f" "$NVRAM"; break; }
    done
    [[ -f "$NVRAM" ]] && echo "  ✓ UEFI nvram at $NVRAM" || echo "  ! OVMF_VARS not found — install edk2-ovmf"
}

ovmf_code() {
    for f in /usr/share/edk2/x64/OVMF_CODE.4m.fd /usr/share/edk2-ovmf/x64/OVMF_CODE.fd; do
        [[ -f "$f" ]] && { echo "$f"; return; }
    done
    die "UEFI firmware not found. Run: sudo pacman -S edk2-ovmf"
}

# How many bytes the disk image actually occupies. A freshly created qcow2 is
# a few hundred KiB of metadata; past a megabyte, something has been written
# to it, which is how `run` decides whether Arch is installed yet.
#
# IT MUST FAIL RATHER THAN GUESS. The first version piped qemu-img straight
# into python with no guard. A running VM holds a write lock on the image, so
# qemu-img could not open it, python read an empty stdin and dumped a
# traceback, and the empty string it printed compared as zero in the test
# below. Zero bytes used reads as "not installed yet" — so the one path that
# offers the Arch installer over a disk that already has Arch on it was
# reached by a probe failing, which is exactly backwards.
disk_used_bytes() {
    local json
    json="$(qemu-img info --output=json "$DISK" 2>/dev/null)" || return 1
    [[ -n "$json" ]] || return 1
    printf '%s' "$json" | python3 -c \
        'import sys,json
try: print(json.load(sys.stdin)["actual-size"])
except Exception: sys.exit(1)' 2>/dev/null
}

cmd_run() {
    need_qemu
    [[ -f "$DISK" ]] || die "No disk yet. Run: khadi-vm create"
    # One VM, one disk. A second would get as far as qemu's own write lock and
    # fail there, after printing enough to look like it was starting.
    local running
    if running="$(vm_pid)"; then
        die "Already running (pid $running).
    ./vm/khadi-vm shot screen.ppm   look at what it is showing
    ./vm/khadi-vm ssh               get a shell in it
    ./vm/khadi-vm stop              shut it down"
    fi
    local boot=() code used; code="$(ovmf_code)"
    if [[ "${1:-}" == "--iso" ]]; then
        [[ -f "$ISO" ]] || die "No ISO yet. Run: khadi-vm fetch"
        boot=(-cdrom "$ISO" -boot d)
        echo "  Booting the installer ISO (asked for with --iso)."
    elif ! used="$(disk_used_bytes)"; then
        die "Cannot read $DISK — qemu-img could not open it.
  Something else is holding it open, or it is corrupt. Refusing to guess:
  guessing here means offering the installer over an installed system.
  Force the installer with: khadi-vm run --iso"
    elif (( used < 1000000 )); then
        [[ -f "$ISO" ]] || die "No ISO yet. Run: khadi-vm fetch"
        boot=(-cdrom "$ISO" -boot d)
        echo "  Disk is empty ($used bytes used). Booting the installer ISO."
    else
        echo "  Booting the installed system."
    fi
    echo "  SSH will be on localhost:$SSH_PORT once sshd runs in the guest."
    echo
    # virtio-gpu-gl + virgl gives the guest a GPU to render through. khadi-comp
    # drives DRM and renders with EGL either way; without this it resolves to
    # llvmpipe and every frame is rasterised on the guest's CPU.
    #
    # EGL vendor selection matters on hybrid graphics. glvnd reads
    # /usr/share/glvnd/egl_vendor.d/ in name order, so 10_nvidia.json wins over
    # 50_mesa.json and EGL lands on the discrete GPU. On this class of machine
    # — Intel iGPU driving the display, NVIDIA secondary, Wayland session —
    # that fails with "eglMakeCurrent failed" and the display silently drops to
    # software. Pin qemu to mesa so it uses the iGPU that actually owns the
    # screen. Override with KHADI_VM_EGL if your setup differs.
    # -vga none is essential: without it QEMU adds its default stdvga at
    # 00:01.0, the guest drives the console from bochs-drm, and virtio-gpu
    # registers with "Cannot find any crtc or sizes" — present but unused.
    # Symptom: xres/yres silently ignored and no 3D in the guest.
    local gpu=() disp
    if [[ "$HEADLESS" == "1" ]]; then
        gpu=(-device "virtio-gpu,xres=$XRES,yres=$YRES")
        disp="none"
        echo "  headless: ${XRES}x${YRES}, VNC on 127.0.0.1:$((5900 + VNC_PORT))"
    elif [[ "$GL" == "on" ]]; then
        export __EGL_VENDOR_LIBRARY_FILENAMES="${KHADI_VM_EGL:-/usr/share/glvnd/egl_vendor.d/50_mesa.json}"
        export __GLX_VENDOR_LIBRARY_NAME="${__GLX_VENDOR_LIBRARY_NAME:-mesa}"
        gpu=(-device "virtio-gpu-gl,xres=$XRES,yres=$YRES")
        disp="gtk,gl=on,show-cursor=on,zoom-to-fit=on"
        echo "  GL on, EGL pinned to: $__EGL_VENDOR_LIBRARY_FILENAMES"
        echo "  If the window fills with 'eglMakeCurrent failed', this host cannot"
        echo "  do it: KHADI_VM_GL=off ./vm/khadi-vm run"
    else
        gpu=(-device "virtio-gpu,xres=$XRES,yres=$YRES")
        disp="gtk,gl=off,show-cursor=on,zoom-to-fit=on"
        echo "  GL off — the host blits each frame. Slower, and 'shot' works."
    fi

    # With virtio-gpu the guest follows the window: resize it and the guest
    # changes mode to match, which is how a 1920x1080 start ends up at 732x810
    # once GTK has shrunk the window to fit the screen with its decorations on.
    # The shell wants 180 columns. Ctrl+Alt+F in the window, or start here.
    # `if`, not `[[ … ]] && …`: under `set -e` a bare AND-list that fails is
    # the whole command, so the common case — fullscreen off — would have
    # exited the script here instead of falling through to boot.
    local full=()
    if [[ "$FULLSCREEN" == "1" ]]; then full=(-full-screen); fi

    exec qemu-system-x86_64 \
        -name "khadi-test" \
        -enable-kvm -cpu host -smp "$CPUS" -m "$RAM" \
        -machine q35,accel=kvm \
        -vga none \
        -drive if=pflash,format=raw,readonly=on,file="$code" \
        -drive if=pflash,format=raw,file="$NVRAM" \
        -drive file="$DISK",if=virtio,format=qcow2 \
        "${boot[@]}" \
        "${gpu[@]}" \
        -display "$disp" \
        "${full[@]}" \
        ${HEADLESS:+$( [[ "$HEADLESS" == 1 ]] && echo "-vnc 127.0.0.1:$VNC_PORT" )} \
        -device virtio-net,netdev=n0 \
        -netdev "user,id=n0,hostfwd=tcp::$SSH_PORT-:22" \
        -device virtio-rng-pci \
        -audiodev none,id=a0 \
        -qmp "unix:$QMP,server,nowait" \
        -usb -device usb-tablet
}

cmd_stop() {
    # ACPI power button, the way the guest expects. Falls back to SIGTERM.
    if [[ -S "$QMP" ]] && have python3; then
        python3 - "$QMP" <<'QPY' 2>/dev/null && { echo "  ✓ power button sent"; return; }
import socket, json, sys
s = socket.socket(socket.AF_UNIX); s.connect(sys.argv[1])
s.recv(4096)
s.sendall(b'{"execute":"qmp_capabilities"}\n'); s.recv(4096)
s.sendall(b'{"execute":"system_powerdown"}\n'); s.recv(4096)
QPY
    fi
    local p; p="$(vm_pid)" && { kill -TERM "$p"; echo "  ✓ SIGTERM sent to $p"; } || echo "  not running"
}

cmd_shot() {
    # Screenshot the guest framebuffer through QMP, independent of the GTK
    # window. Lets the host verify what the guest is actually displaying.
    local out="${1:-$HERE/shot.ppm}"
    [[ -S "$QMP" ]] || die "no QMP socket — is the VM running?"
    python3 - "$QMP" "$out" <<'QPY'
import socket, json, sys
s = socket.socket(socket.AF_UNIX); s.connect(sys.argv[1]); s.recv(65536)
def q(o):
    s.sendall((json.dumps(o)+"\n").encode())
    while True:
        for ln in s.recv(65536).decode().splitlines():
            d = json.loads(ln)
            if "return" in d or "error" in d: return d
q({"execute":"qmp_capabilities"})
r = q({"execute":"screendump","arguments":{"filename":sys.argv[2]}})
print("  error:" if "error" in r else "  ok", r.get("error",""))
QPY
    [[ -f "$out" ]] && echo "  ✓ $out ($(identify -format '%wx%h' "$out" 2>/dev/null || stat -c%s "$out") )"
}

cmd_ssh() {
    exec ssh -p "$SSH_PORT" \
        -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
        "${KHADI_VM_USER:-root}@localhost" "$@"
}

cmd_push() {
    echo "  Copying the repo into the guest…"
    # The whole directory goes, rather than a list of paths to refresh. tar
    # adds files but never removes them, so a renamed or deleted one lives on
    # in the guest forever — which is how an orphaned khadi-tron.theme once
    # survived a rename and poisoned every theme. Enumerating what to delete
    # was the old fix and it rotted the moment the layout changed: it still
    # named templates/ and crates/, which no longer exist, while missing
    # common/ and compositor/, which do. Replacing the lot cannot go stale.
    #
    # Extracted beside the old tree and swapped, so nothing is deleted until
    # the transfer has landed. Deleting first and then piping is one dropped
    # connection away from a guest with no repo on it at all.
    tar -C "$ROOT" \
        --exclude=edex-ui --exclude=omarchy --exclude=.git --exclude=target \
        --exclude='vm/*.iso' --exclude='vm/*.iso.part' \
        --exclude='vm/*.qcow2' --exclude='vm/OVMF_VARS.fd' --exclude='vm/.qmp.sock' \
        -cf - . \
      | ssh -p "$SSH_PORT" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
            -o LogLevel=ERROR "${KHADI_VM_USER:-root}@localhost" \
            'set -e
             rm -rf ~/.khadi-incoming ~/.khadi-outgoing
             mkdir -p ~/.khadi-incoming
             tar -C ~/.khadi-incoming -xf -
             if [ -d ~/khadi ]; then mv ~/khadi ~/.khadi-outgoing; fi
             # The build cache moves across rather than being thrown away with the
             # old tree. It is not in the tar (--exclude=target), so replacing the
             # tree wholesale meant every push cost a twenty-minute rebuild of a
             # dependency graph that had not changed.
             if [ -d ~/.khadi-outgoing/target ]; then
                 mv ~/.khadi-outgoing/target ~/.khadi-incoming/target
             fi
             mv ~/.khadi-incoming ~/khadi
             rm -rf ~/.khadi-outgoing'
    echo "  ✓ repo is at ~/khadi in the guest"

    # NO BINARIES. They used to be pushed from the host because the guest had
    # no Rust toolchain and building in a VM was slow. That made the guest a
    # place binaries were delivered to rather than a machine Khadi installs
    # on, and it is exactly the thing provisioning is supposed to prove. The
    # guest builds its own now; `rust` is in packages.txt.
}

# Type into the guest's console over QMP. The greeter is the one surface that
# cannot be driven over ssh — it owns a VT and reads a keyboard — so without
# this, "can anyone actually log in" stays untested, which for a login screen
# is the only question that matters.
#
#   khadi-vm type khadi        send the literal string
#   khadi-vm type khadi ret    trailing `ret` presses Enter
cmd_type() {
    [[ -S "$QMP" ]] || die "no QMP socket — is the VM running?"
    python3 - "$QMP" "$@" <<'TPY'
import socket, json, sys, time
sock, args = sys.argv[1], sys.argv[2:]
s = socket.socket(socket.AF_UNIX); s.connect(sock); s.recv(65536)
def q(o):
    s.sendall((json.dumps(o)+"\n").encode())
    while True:
        for ln in s.recv(65536).decode().splitlines():
            d = json.loads(ln)
            if "return" in d or "error" in d:
                return d
q({"execute": "qmp_capabilities"})
SHIFTED = {"!":"1","@":"2","#":"3","$":"4","%":"5","^":"6","&":"7","*":"8","(":"9",")":"0",
           "_":"minus","+":"equal",":":"semicolon","\"":"apostrophe","<":"comma",">":"dot","?":"slash"}
PLAIN = {" ":"spc","-":"minus","=":"equal",".":"dot",",":"comma","/":"slash",";":"semicolon",
         "'":"apostrophe","\n":"ret"}
def keys_for(ch):
    if ch in PLAIN: return [PLAIN[ch]], False
    if ch in SHIFTED: return [SHIFTED[ch]], True
    if ch.isdigit(): return [ch], False
    if ch.isalpha(): return [ch.lower()], ch.isupper()
    raise SystemExit(f"khadi-vm type: no key mapping for {ch!r}")
for arg in args:
    if arg in ("ret", "tab", "esc", "spc", "backspace"):
        q({"execute": "send-key", "arguments": {"keys": [{"type": "qcode", "data": arg}]}})
        time.sleep(0.08); continue
    for ch in arg:
        names, shift = keys_for(ch)
        ks = ([{"type": "qcode", "data": "shift"}] if shift else []) + \
             [{"type": "qcode", "data": n} for n in names]
        q({"execute": "send-key", "arguments": {"keys": ks}})
        time.sleep(0.05)
TPY
}

# Starting the session without going through greetd. The compositor needs a
# seat, which ssh does not give you, so anything that has to look at a running
# desktop needs the guest to bring one up by itself on boot.
#
# TEST SCAFFOLDING, written into the guest and nowhere near the repo: Khadi's
# own session manager is greetd, which asks for a password on purpose.
cmd_autologin() {
    local rc
    rc=$(cat <<'GUEST'
set -e
# greetd also wants vt1. Leaving it enabled means two things race for the
# console and which one wins depends on boot timing.
sudo systemctl disable --now greetd 2>/dev/null || true
sudo mkdir -p /etc/systemd/system/getty@tty1.service.d
printf '[Service]\nExecStart=\nExecStart=-/usr/bin/agetty --autologin %s --noclear %%I $TERM\n' "$USER" \
    | sudo tee /etc/systemd/system/getty@tty1.service.d/autologin.conf >/dev/null
# Both login profiles, because which one agetty's shell reads depends on the
# account's shell and this guest has had both. Writing only ~/.bash_profile
# left a zsh account logging straight in to a prompt, with the session never
# started and nothing to say why.
#
# Rewritten every time, not appended once. Skipping the write when the markers
# were already there meant a guest provisioned before the des-ui replacement
# kept execing `start-hyprland` — so a VM with the new compositor installed
# still booted the old desktop over the top of it, and nothing said so.
for profile in ~/.bash_profile ~/.zprofile; do
python3 - "$profile" <<'STRIP'
import re, sys, pathlib
p = pathlib.Path(sys.argv[1])
s = p.read_text() if p.exists() else ""
p.write_text(re.sub(r'\n*# >>> KHADI-VM-TEST >>>.*?# <<< KHADI-VM-TEST <<<\n', '', s, flags=re.S))
STRIP
cat >> "$profile" <<'EOF'

# >>> KHADI-VM-TEST >>> scaffolding, not part of Khadi. Starts the session on
# tty1 without a login, for checking loaded state against a real compositor.
if [ -z "$WAYLAND_DISPLAY" ] && [ "$(tty)" = /dev/tty1 ]; then
    exec /usr/local/bin/khadi-session > ~/.cache/khadi-start.log 2>&1
fi
# <<< KHADI-VM-TEST <<<
EOF
done
sudo systemctl daemon-reload
sudo systemctl restart getty@tty1
GUEST
)
    echo "  Enabling autologin + session on tty1 in the guest…"
    ssh -p "$SSH_PORT" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
        -o LogLevel=ERROR "${KHADI_VM_USER:-root}@localhost" "bash -s" <<<"$rc"
    echo "  ✓ session starting. Give it ~20s, then:"
    echo "      ./vm/khadi-vm shot session.png"
}

cmd_status() {
    printf '  %-12s %s\n' "vm" "$(vm_pid >/dev/null && echo "running (pid $(vm_pid))" || echo 'stopped')"
    printf '  %-12s %s\n' "qemu"  "$(have qemu-system-x86_64 && qemu-system-x86_64 --version | head -1 || echo 'NOT INSTALLED')"
    printf '  %-12s %s\n' "kvm"   "$( [[ -w /dev/kvm ]] && echo ok || echo unavailable )"
    printf '  %-12s %s\n' "iso"   "$( [[ -f $ISO ]] && du -h "$ISO" | cut -f1 || echo 'not fetched' )"
    printf '  %-12s %s\n' "disk"  "$( [[ -f $DISK ]] && du -h "$DISK" | cut -f1 || echo 'not created' )"
    printf '  %-12s %s\n' "ram"   "$RAM"
    printf '  %-12s %s\n' "cpus"  "$CPUS"
    local cols; cols=$(python3 -c "print(int($XRES/(10*96/72*0.5)))" 2>/dev/null || echo '?')
    printf '  %-12s %s\n' "display" "${XRES}x${YRES}  (~$cols cols at Iosevka Term 10; layout needs >=180)"
    printf '  %-12s %s\n' "gl" "$GL"
}

cmd_clean() {
    rm -f "$DISK" "$NVRAM"
    echo "  ✓ disk removed (ISO kept — 'rm $ISO' to drop that too)"
}

case "${1:-status}" in
    deps) cmd_deps ;;
    fetch) cmd_fetch ;;
    create) cmd_create ;;
    run) shift; cmd_run "$@" ;;
    stop) cmd_stop ;;
    shot) shift; cmd_shot "$@" ;;
    ssh) shift; cmd_ssh "$@" ;;
    autologin) cmd_autologin ;;
    type) shift; cmd_type "$@" ;;
    push) cmd_push ;;
    status) cmd_status ;;
    clean) cmd_clean ;;
    *) sed -n '2,16p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
esac
