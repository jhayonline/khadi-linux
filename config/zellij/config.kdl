// GENERATED by khadi-theme from themes/tron.toml — edit templates/zellij/config.kdl.tmpl, not this file.
// Khadi — zellij config.
// Colours derived from themes/tron.toml; Phase 2 generates this file.

// Frames OFF. zellij does layout, not looks — the Phase 0 gate proved its
// glyph vocabulary cannot carry the bracket tick. Chrome is drawn by whatever
// occupies the pane. Note the vertical `│` divider survives this setting; it
// is colourable, not removable.
pane_frames false
pane_frame_style "none"

show_release_notes false
show_startup_tips false
mouse_hover_tips false
default_layout "khadi"
theme "khadi"

// Keyboard model, PLAN.md section 6: each layer owns one modifier.
// zellij owns Alt, exclusively. Ctrl stays clean for applications.
keybinds clear-defaults=true {
    normal {
        bind "Alt n" { NewPane; }
        bind "Alt d" { NewPane "Down"; }
        bind "Alt r" { NewPane "Right"; }
        bind "Alt x" { CloseFocus; }
        bind "Alt h" "Alt Left"  { MoveFocusOrTab "Left"; }
        bind "Alt l" "Alt Right" { MoveFocusOrTab "Right"; }
        bind "Alt j" "Alt Down"  { MoveFocus "Down"; }
        bind "Alt k" "Alt Up"    { MoveFocus "Up"; }
        bind "Alt =" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
        bind "Alt f" { ToggleFocusFullscreen; }
        bind "Alt t" { NewTab; }
        bind "Alt w" { CloseTab; }
        bind "Alt q" { Quit; }
        bind "Alt z" { TogglePaneFrames; }   // escape hatch while iterating
    }
}

themes {
    khadi {
        fg      170 207 209
        bg      5 8 13
        black   0 0 0
        white   170 207 209
        // ANSI 16, resolved by khadi-theme — declared by the theme, or
        // collapsed onto the alpha ramp when it declares none.
        red     154 187 189
        green     170 207 209
        yellow     137 167 170
        blue     104 127 131
        magenta     120 147 150
        cyan     170 207 209
        orange  88 108 111
    }
}
