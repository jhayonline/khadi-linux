// GENERATED by khadi-theme from themes/tron.toml — edit templates/zellij/layouts/khadi.kdl.tmpl, not this file.
// Khadi — reference layout.
//
// The eDEX arrangement: system left, shell centre, processes right, filesystem
// along the bottom. The on-screen keyboard and GeoIP globe are non-goals
// (PLAN.md section 12).
//
// Frames are off (config.kdl). Every pane draws its own chrome — the
// correction the Phase 0 gate forced: zellij does layout, not looks.
//
// COLUMN WIDTHS ARE A MEASUREMENT, NOT A TASTE. eDEX's side columns are ~17%
// of screen width. btop could not hold one — its CPU box refuses to render
// below 60 columns and its process box below 44 — which is why khadi-hud was
// written; it draws clock, hardware, CPU, memory, swap and processes in 34.
// zellij's `│` divider eats a column, so the sizes here are 40 plus chrome.
// FORTY, not thirty-four: eDEX's columns are 17% of screen width, which is
// 326px at 1920 and 40 cells of Iosevka Term at size 10. Khadi shipped 34,
// which is 14.5% — the columns read as thin strips against a screen that was
// mostly empty, and the clock had no room to be more than a row of posts.
//
// This layout needs >=180 columns to hold eDEX-like proportions, and reaches
// eDEX's own ~34% split at 217. See PLAN.md section 10.

layout {
    pane split_direction="vertical" {
        pane size=42 name="SYSTEM"    command="khadi-panel" { args "system"; }
        pane split_direction="horizontal" {
            // A/B item 10. The TERMINAL / MAIN SHELL header is chrome for the
            // shell, and neither surface that could own it will: the Phase 0
            // gate ruled out zellij's frame glyphs, and anything the shell
            // itself prints scrolls away with the first screenful of output.
            // So it gets a pane, two rows tall, exactly as the panels did.
            //
            // size=3 for a two-row header: zellij's horizontal divider eats a
            // row the same way its `│` eats a column, and the header renders
            // nothing at all below two rows. Measured, not guessed — at size=2
            // the pane gets a one-row pty and stays blank, which looks like a
            // broken binary rather than a sizing mistake.
            pane size=3 name="TERMINAL" command="khadi-panel" { args "header"; }
            // Focus starts on the shell. Without this zellij focuses the
            // first pane in the layout, which is the SYSTEM readout.
            pane focus=true name="MAIN SHELL"
            // FILESYSTEM sits UNDER THE SHELL, not across the whole screen.
            // eDEX's is the bottom-left quarter — 43vw of 100, beside the
            // on-screen keyboard — and Khadi's was a five-row strip spanning
            // everything, which is both the wrong shape and the wrong size.
            // A third of the centre column is the closest rectangle to eDEX's
            // proportion that a tiling layout can express.
            pane size="34%" name="FILESYSTEM" command="khadi-panel" { args "fs"; }
        }
        pane size=44 name="NETWORK"   command="khadi-panel" { args "net"; }
    }
}
