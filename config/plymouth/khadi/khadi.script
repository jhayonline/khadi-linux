# GENERATED by khadi-theme from themes/tron.toml — edit templates/plymouth/khadi/khadi.script.tmpl, not this file.
# Khadi — Plymouth boot splash.
#
# The first thing anyone sees, and the only part of the aesthetic that runs
# before a compositor exists.
#
# Composed after Omarchy's: a wordmark and a thin progress bar, centred, on the
# theme ground. Not eDEX's boot screen, which is assets/misc/boot_log.txt —
# 85 lines of invented macOS kernel messages replayed with a delay and a sound
# per line, opening "Welcome to eDEX-UI!". A fake log is theatre; a wordmark is
# just a wordmark.
#
# ONE REAL STATUS LINE is kept under the bar. Omarchy's has none, and it is the
# one addition worth making: a boot screen that says nothing while it hangs is
# a support ticket. systemd feeds plymouth genuine unit status through
# SetUpdateStatusFunction, so it costs nothing and it is true.
#
# EVERYTHING IS TEXT. Plymouth script has no rectangle primitive, so themes
# ship PNGs for their logos and bars — Omarchy's ships five. Khadi's wordmark
# is drawn from characters, so the splash has no image assets at all and
# restyles from themes/*.toml like every other config.
#
# ASCII, NOT THE BOX-DRAWING MOTIF, and this was measured rather than chosen.
# An initramfs carries only `label-freetype.so`; `label-pango.so` would drag in
# pango, harfbuzz and fontconfig. That renderer draws Latin correctly and
# returns .notdef for everything multi-byte, so an earlier version came up with
# "KHADI" in the right face above a rule of tofu boxes. The font was never the
# problem: Iosevka Term is correctly baked in and does carry U+2500, verified
# by extracting the initramfs and querying it.

Window.SetBackgroundTopColor(0.0196, 0.0314, 0.0510);
Window.SetBackgroundBottomColor(0.0196, 0.0314, 0.0510);

fun text(s, r, g, b) {
    return Image.Text(s, r, g, b);
}

# --- the wordmark ----------------------------------------------------------
# A 5x7 block face, one row per Image.Text. Same idea as khadi-hud's block
# clock — Khadi draws large text out of small marks rather than shipping a
# bitmap — and here it is also the only option, since a PNG would not restyle
# with the theme.
#
# EACH PIXEL IS TWO CHARACTERS WIDE, and the row spacing is tighter than the
# line height, because there is only ONE font size available: Image.Text takes
# its size from a font string, and a font string cannot be resolved inside an
# initramfs (see the header). So the wordmark cannot be set larger than the
# status line under it — it can only be built from more marks. Doubling the
# width and closing the leading is what turns a sparse dot grid into letters.
global.logo = [];
global.logo[0] = "##      ##  ##      ##    ######    ########    ##########";
global.logo[1] = "##    ##    ##      ##  ##      ##  ##      ##      ##    ";
global.logo[2] = "##  ##      ##      ##  ##      ##  ##      ##      ##    ";
global.logo[3] = "####        ##########  ##########  ##      ##      ##    ";
global.logo[4] = "##  ##      ##      ##  ##      ##  ##      ##      ##    ";
global.logo[5] = "##    ##    ##      ##  ##      ##  ##      ##      ##    ";
global.logo[6] = "##      ##  ##      ##  ##      ##  ########    ##########";

global.logo_lead = 13;
global.logo_sprite = [];
global.logo_top = Window.GetHeight() / 2 - 7 * global.logo_lead / 2 - 40;

for (i = 0; i < 7; i++) {
    img = text(global.logo[i], 0.6667, 0.8118, 0.8196);
    global.logo_sprite[i] = Sprite(img);
    global.logo_sprite[i].SetPosition(
        Window.GetWidth() / 2 - img.GetWidth() / 2,
        global.logo_top + i * global.logo_lead, 10);
}

# --- progress --------------------------------------------------------------
# Short and centred, like the reference. The track is drawn once so the bar has
# something to move along instead of appearing out of nothing.
global.bar_cols = 32;
global.bar_y = global.logo_top + 7 * global.logo_lead + 34;
global.max_progress = 0.0;

fun bar_string(n, fill, rest) {
    s = "";
    for (i = 0; i < global.bar_cols; i++) {
        if (i < n) {
            s = s + fill;
        } else {
            s = s + rest;
        }
    }
    return s;
}

track = text(bar_string(0, "-", "-"), 0.1490, 0.1882, 0.2039);
global.track_sprite = Sprite(track);
global.track_sprite.SetPosition(Window.GetWidth() / 2 - track.GetWidth() / 2, global.bar_y, 10);
global.bar_left = Window.GetWidth() / 2 - track.GetWidth() / 2;

global.bar_sprite = Sprite();
global.bar_sprite.SetPosition(global.bar_left, global.bar_y, 11);
global.bar_sprite.SetOpacity(0);

fun draw_progress(p) {
    if (p <= global.max_progress) return;
    global.max_progress = p;
    n = Math.Int(p * global.bar_cols);
    if (n < 1) n = 1;
    img = text(bar_string(n, "#", " "), 0.6667, 0.8118, 0.8196);
    global.bar_sprite.SetImage(img);
    global.bar_sprite.SetOpacity(1);
}

fun progress_callback(duration, progress) {
    draw_progress(progress);
}
Plymouth.SetBootProgressFunction(progress_callback);

# --- one status line -------------------------------------------------------
global.status_y = global.bar_y + 40;
global.status_sprite = Sprite();
global.status_sprite.SetOpacity(0);

fun say(line) {
    img = text(line, 0.3451, 0.4235, 0.4353);
    global.status_sprite.SetImage(img);
    global.status_sprite.SetPosition(
        Window.GetWidth() / 2 - img.GetWidth() / 2, global.status_y, 10);
    global.status_sprite.SetOpacity(1);
}

fun status_callback(status) {
    say(status);
}
Plymouth.SetUpdateStatusFunction(status_callback);
Plymouth.SetDisplayMessageFunction(status_callback);

# --- the disk password -----------------------------------------------------
# LUKS is on by default (PLAN.md section 8), so on an encrypted install this is
# the first thing typed on a Khadi machine — before the greeter, before the
# compositor.
global.prompt_sprite = Sprite();
global.prompt_sprite.SetOpacity(0);
global.bullet_sprite = Sprite();
global.bullet_sprite.SetOpacity(0);

fun centre(sprite, img, y) {
    sprite.SetImage(img);
    sprite.SetPosition(Window.GetWidth() / 2 - img.GetWidth() / 2, y, 20);
    sprite.SetOpacity(1);
}

fun password_callback(prompt, bullets) {
    global.status_sprite.SetOpacity(0);
    global.track_sprite.SetOpacity(0);
    global.bar_sprite.SetOpacity(0);

    centre(global.prompt_sprite, text(prompt, 0.5373, 0.6549, 0.6667), global.bar_y);

    s = "";
    for (i = 0; i < bullets; i++) {
        s = s + "*";
    }
    centre(global.bullet_sprite, text(s, 0.6667, 0.8118, 0.8196), global.status_y);
}
Plymouth.SetDisplayPasswordFunction(password_callback);

fun normal_callback() {
    global.prompt_sprite.SetOpacity(0);
    global.bullet_sprite.SetOpacity(0);
    global.track_sprite.SetOpacity(1);
}
Plymouth.SetDisplayNormalFunction(normal_callback);
