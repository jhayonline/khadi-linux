# GENERATED by khadi-theme from themes/tron.toml — edit templates/plymouth/khadi/khadi.script.tmpl, not this file.
# Khadi — Plymouth boot splash.
#
# The first thing anyone sees, and the only part of the aesthetic that runs
# before a compositor exists.
#
# Composed after Omarchy's: a wordmark and a thin progress bar, centred, on the
# theme ground. Not eDEX's boot screen, which is assets/misc/boot_log.txt —
# 85 lines of invented macOS kernel messages replayed with a delay and a sound
# per line, opening "Welcome to eDEX-UI!". A fake log is theatre; a wordmark is
# just a wordmark.
#
# ONE REAL STATUS LINE is kept under the bar. Omarchy's has none, and it is the
# one addition worth making: a boot screen that says nothing while it hangs is
# a support ticket. systemd feeds plymouth genuine unit status through
# SetUpdateStatusFunction, so it costs nothing and it is true.
#
# THIS USED TO BE ALL TEXT, and it looked like debug output. Two beliefs put it
# there and only one of them was true.
#
# TRUE: large text is impossible here. `Image.Text` takes its size from a font
# string and a font string cannot be resolved inside an initramfs — section
# 10m, measured by extracting one — so the wordmark was built from `##` at the
# single size available. You could see the hash glyphs.
#
# FALSE: "a PNG would not restyle with the theme". That holds for a PNG someone
# draws by hand. It does not hold for one khadi-theme GENERATES: wordmark.png
# is geometry filled in role.text, rebuilt for every theme like every other
# output, with no font and no dependency outside the standard library.
#
# AND PLYMOUTH DOES HAVE A RECTANGLE after all. The old comment said it had
# none, which is why the progress bar was a row of dashes. `Image.Scale(w, h)`
# on a one-pixel swatch is a rectangle at any size — so the hairlines, the
# ticks and the bar are real geometry now.

Window.SetBackgroundTopColor(0.0196, 0.0314, 0.0510);
Window.SetBackgroundBottomColor(0.0196, 0.0314, 0.0510);

fun text(s, r, g, b) {
    return Image.Text(s, r, g, b);
}

# --- primitives ------------------------------------------------------------
# One pixel, scaled. See the header.
global.px_text = Image("px-text.png");
global.px_rule = Image("px-rule.png");
global.px_dim  = Image("px-dim.png");

global.W = Window.GetWidth();
global.H = Window.GetHeight();

fun rect(px, x, y, w, h, z) {
    s = Sprite(px.Scale(w, h));
    s.SetPosition(x, y, z);
    return s;
}

# The signature motif: a hairline that terminates in a tick at each end. The
# same `┬───┬` every Khadi surface opens with, as three rectangles.
# Sprites must be kept alive in globals or plymouth drops them, and the index
# is counted by hand rather than asked for: plymouth script is not JavaScript
# and an array method that does not exist fails as a BLANK SCREEN at boot,
# which is the most expensive way there is to find a typo.
global.rules = [];
global.nrules = 0;
fun ticked_rule(x, y, w) {
    global.rules[global.nrules] = rect(global.px_rule, x, y, w, 1, 10);
    global.rules[global.nrules + 1] = rect(global.px_rule, x, y, 1, 7, 10);
    global.rules[global.nrules + 2] = rect(global.px_rule, x + w - 1, y, 1, 7, 10);
    global.nrules = global.nrules + 3;
}

# --- the wordmark ----------------------------------------------------------
global.logo = Image("wordmark.png");
global.logo_sprite = Sprite(global.logo);
global.logo_x = global.W / 2 - global.logo.GetWidth() / 2;
global.logo_y = global.H / 2 - global.logo.GetHeight() / 2 - 60;
global.logo_sprite.SetPosition(global.logo_x, global.logo_y, 10);

# A rule under it, the width of the wordmark, so the mark sits ON something.
ticked_rule(global.logo_x, global.logo_y + global.logo.GetHeight() + 26,
            global.logo.GetWidth());

# --- progress --------------------------------------------------------------
# A real bar: a dim track with the fill drawn over it, both three pixels tall,
# with the same ticks at each end. It was a string of dashes because the old
# script believed Plymouth had no rectangle.
global.bar_w = global.logo.GetWidth();
global.bar_x = global.logo_x;
global.bar_y = global.logo_y + global.logo.GetHeight() + 74;
global.max_progress = 0.0;

global.track_sprite = rect(global.px_dim, global.bar_x, global.bar_y, global.bar_w, 3, 10);
global.bar_sprite = Sprite();
global.bar_sprite.SetPosition(global.bar_x, global.bar_y, 11);
global.bar_sprite.SetOpacity(0);
ticked_rule(global.bar_x, global.bar_y - 5, global.bar_w);

fun draw_progress(p) {
    if (p <= global.max_progress) return;
    global.max_progress = p;
    w = Math.Int(p * global.bar_w);
    if (w < 2) w = 2;
    global.bar_sprite.SetImage(global.px_text.Scale(w, 3));
    global.bar_sprite.SetOpacity(1);
}

fun progress_callback(duration, progress) {
    draw_progress(progress);
}
Plymouth.SetBootProgressFunction(progress_callback);

# --- one status line -------------------------------------------------------
# Small text, which is the one size Image.Text can set here, and the one place
# that size is the right one.
global.status_y = global.bar_y + 30;
global.status_sprite = Sprite();
global.status_sprite.SetOpacity(0);

fun say(line) {
    img = text(line, 0.3451, 0.4235, 0.4353);
    global.status_sprite.SetImage(img);
    global.status_sprite.SetPosition(global.W / 2 - img.GetWidth() / 2, global.status_y, 10);
    global.status_sprite.SetOpacity(1);
}

fun status_callback(status) {
    say(status);
}
Plymouth.SetUpdateStatusFunction(status_callback);
Plymouth.SetDisplayMessageFunction(status_callback);

# --- the disk password -----------------------------------------------------
# LUKS is on by default (PLAN.md section 8), so on an encrypted install this is
# the first thing typed on a Khadi machine — before the greeter, before the
# compositor.
global.prompt_sprite = Sprite();
global.prompt_sprite.SetOpacity(0);
global.bullet_sprite = Sprite();
global.bullet_sprite.SetOpacity(0);

fun centre(sprite, img, y) {
    sprite.SetImage(img);
    sprite.SetPosition(Window.GetWidth() / 2 - img.GetWidth() / 2, y, 20);
    sprite.SetOpacity(1);
}

fun password_callback(prompt, bullets) {
    global.status_sprite.SetOpacity(0);
    global.track_sprite.SetOpacity(0);
    global.bar_sprite.SetOpacity(0);

    centre(global.prompt_sprite, text(prompt, 0.5373, 0.6549, 0.6667), global.bar_y - 6);

    s = "";
    for (i = 0; i < bullets; i++) {
        s = s + "*";
    }
    centre(global.bullet_sprite, text(s, 0.6667, 0.8118, 0.8196), global.status_y);
}
Plymouth.SetDisplayPasswordFunction(password_callback);

fun normal_callback() {
    global.prompt_sprite.SetOpacity(0);
    global.bullet_sprite.SetOpacity(0);
    global.track_sprite.SetOpacity(1);
}
Plymouth.SetDisplayNormalFunction(normal_callback);
