// Khadi — waybar. PLACEHOLDER: khadi-hud panel retires this in Phase 3b.
// Derived from themes/tron.toml. Phase 2 generates it.
{
  "layer": "top",
  "position": "top",
  "height": 26,
  "spacing": 0,
  "modules-left": [
    "custom/panel",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "network",
    "battery",
    "custom/system"
  ],
  "custom/panel": {
    "format": "PANEL",
    "tooltip": false
  },
  "custom/system": {
    "format": "SYSTEM",
    "tooltip": false
  },
  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate"
  },
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%Y-%m-%d}"
  },
  "cpu": {
    "format": "CPU {usage:>3}%",
    "interval": 2
  },
  "memory": {
    "format": "MEM {percentage:>3}%",
    "interval": 5
  },
  "network": {
    "format-wifi": "NET {signalStrength}%",
    "format-ethernet": "NET {ipaddr}",
    "format-disconnected": "NET  --",
    "tooltip": false
  },
  "battery": {
    "format": "PWR {capacity:>3}%",
    "format-charging": "CHG {capacity:>3}%",
    "states": {
      "low": 20
    }
  }
}
