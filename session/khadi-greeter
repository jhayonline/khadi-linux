#!/bin/sh
# Runs the Khadi login screen for greetd, the login manager.
#
# The screen is shown by khadi-comp, the same compositor the desktop uses, with the
# login screen in the shell's place. If that cannot start, a plain text login takes
# over, so that a broken build never leaves the machine with no way to sign in.
log=/var/lib/khadi/greeter/login.log
[ -w "$(dirname "$log")" ] || log=/dev/null

started=$(date +%s)
/usr/local/bin/khadi-comp --backend drm --no-xwayland -- --greeter >"$log" 2>&1
status=$?
elapsed=$(( $(date +%s) - started ))
echo "khadi-comp exited with status $status after ${elapsed}s" >>"$log"

# It exits cleanly once someone has signed in; greetd starts their session next.
# After running for a while, a failure is something greetd should simply retry.
if [ "$status" -eq 0 ] || [ "$elapsed" -ge 10 ]; then
    exit "$status"
fi

echo "The Khadi login screen could not start (status $status). Sign in here instead."
if command -v agreety >/dev/null; then
    exec agreety --cmd /usr/local/bin/khadi-session
fi
exit "$status"
