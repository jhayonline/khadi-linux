#!/bin/sh
# Login session for the khadi desktop.
#
# khadi-comp first tries to drive the display and input devices itself. If that fails
# within the first seconds, the session tries the build that was installed before this
# one, and then running inside the cage kiosk compositor, so that a broken build or a
# problem with the hardware backend does not lock you out.
#
# Logs: ~/.local/state/khadi/session.log (and session-fallback.log); what launched
# applications print goes to apps.log next to them.
export XDG_CURRENT_DESKTOP=khadi
# Any display variables inherited from the login manager would make khadi-comp think it
# is running inside another desktop.
unset WAYLAND_DISPLAY DISPLAY

# This desktop was called edex-rs before: bring along what it kept under that name.
for kept in "${XDG_CONFIG_HOME:-$HOME/.config}" "${XDG_CACHE_HOME:-$HOME/.cache}" "${XDG_STATE_HOME:-$HOME/.local/state}"; do
    if [ -d "$kept/edex-rs" ] && [ ! -e "$kept/khadi" ]; then
        mv "$kept/edex-rs" "$kept/khadi"
    elif [ -d "$kept/edex-rs" ] && [ ! -e "$kept/khadi/.carried-over" ]; then
        # Both are there: something made the new one first. Whatever only the old
        # one has still comes along, once.
        cp -r --update=none "$kept/edex-rs/." "$kept/khadi/" 2>/dev/null
        : > "$kept/khadi/.carried-over"
    fi
done

log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/khadi"
mkdir -p "$log_dir"

# The desktop portal serves one session at a time: one left over from another desktop
# must go before this session starts, and ours before the next one does.
stop_portal() {
    systemctl --user stop xdg-desktop-portal.service xdg-desktop-portal-gtk.service \
        xdg-desktop-portal-gnome.service 2>/dev/null
    systemctl --user reset-failed xdg-desktop-portal.service xdg-desktop-portal-gtk.service \
        xdg-desktop-portal-gnome.service 2>/dev/null
}
leave() {
    stop_portal
    # The music service runs apart from the shell, so that restarting the shell does
    # not stop the music; it ends with the session.
    pkill -u "$(id -u)" -x khadi-music 2>/dev/null
    systemctl --user unset-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE 2>/dev/null
    exit "$1"
}
stop_portal

started=$(date +%s)
/usr/local/bin/khadi-comp --session --backend drm "$@" >"$log_dir/session.log" 2>&1
status=$?
elapsed=$(( $(date +%s) - started ))

# A clean exit, or a session that ran for a while, is an ordinary logout.
if [ "$status" -eq 0 ] || [ "$elapsed" -ge 15 ]; then
    leave "$status"
fi

previous=/usr/local/lib/khadi/previous
if [ -x "$previous/khadi-comp" ] && [ -x "$previous/khadi" ]; then
    echo "khadi-comp exited with status $status after ${elapsed}s; trying the previous build" \
        >>"$log_dir/session.log"
    started=$(date +%s)
    "$previous/khadi-comp" --session --backend drm --shell "$previous/khadi" "$@" \
        >"$log_dir/session-previous.log" 2>&1
    status=$?
    elapsed=$(( $(date +%s) - started ))
    if [ "$status" -eq 0 ] || [ "$elapsed" -ge 15 ]; then
        leave "$status"
    fi
fi

echo "khadi-comp exited with status $status after ${elapsed}s; falling back to cage" \
    >>"$log_dir/session.log"
if command -v cage >/dev/null; then
    # -s keeps Ctrl+Alt+F<n> VT switching available as a way out.
    cage -s -- /usr/local/bin/khadi-comp --session --backend winit "$@" >"$log_dir/session-fallback.log" 2>&1
    leave $?
fi
leave "$status"
