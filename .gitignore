/target

# eDEX-UI's theme files are GPL-3.0; only this project's own theme is kept here.
/themes/*
!/themes/signal.json

# VM artefacts — large, local, reproducible from vm/khadi-vm. The VM is the
# only safe way to test a compositor: it takes over the display, so trying a
# build on the machine you are working on logs you out of it.
vm/*.iso
vm/*.iso.part
vm/*.qcow2
vm/OVMF_VARS.fd
vm/.qmp.sock
# Screen captures. `khadi-vm shot` writes one wherever you ask it to, and the
# obvious place to ask for is the directory you are standing in.
*.ppm

# Reference clones, not ours to version
edex-ui/
omarchy/

__pycache__/
*.pyc

# The upstream project this descends from, kept here to merge from. Its
# directory keeps upstream's name on purpose: it is his checkout, not ours,
# and the rename pass must not touch it.
des-ui/
