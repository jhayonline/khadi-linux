# Khadi — GTK4 settings. See templates/gtk-3.0/settings.ini.tmpl for why this
# is settings rather than a theme.
#
# GTK4 ignores gtk-theme-name for libadwaita apps — they follow the colour
# scheme from the Settings portal instead, which is why the session also sets
# `org.gnome.desktop.interface color-scheme`. This file still covers the GTK4
# apps that are not libadwaita, and the font applies to both.

[Settings]
gtk-icon-theme-name=Adwaita
gtk-application-prefer-dark-theme=1
gtk-font-name={{ font.ui }} 11
