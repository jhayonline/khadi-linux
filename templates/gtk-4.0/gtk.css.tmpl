/* Khadi — GTK recolouring. Derived from the theme.
 *
 * COLOURS ONLY, DELIBERATELY. It is tempting to carry the whole design
 * language over — eDEX has no rounded anything and no shadows, and bar.css
 * squares off every corner it owns. But bar.css owns its widgets; this file
 * does not. A stylesheet that fights someone else's toolkit loses, slowly, in
 * ways that surface as "this app looks broken" months later. Recolouring is
 * the part that is both safe and most of the effect.
 *
 * These are the named colours libadwaita and Adwaita resolve against, so an
 * app that respects the theme picks them up without knowing Khadi exists.
 */

@define-color window_bg_color {{ role.ground | hex }};
@define-color window_fg_color {{ role.text | hex }};
@define-color view_bg_color {{ role.ground | hex }};
@define-color view_fg_color {{ role.text | hex }};
@define-color headerbar_bg_color {{ ramp.a10 | hex }};
@define-color headerbar_fg_color {{ role.text | hex }};
@define-color popover_bg_color {{ ramp.a10 | hex }};
@define-color popover_fg_color {{ role.text | hex }};
@define-color card_bg_color {{ ramp.a10 | hex }};
@define-color card_fg_color {{ role.text | hex }};
@define-color dialog_bg_color {{ ramp.a10 | hex }};
@define-color dialog_fg_color {{ role.text | hex }};
@define-color sidebar_bg_color {{ ramp.a10 | hex }};
@define-color sidebar_fg_color {{ role.text | hex }};

/* The one-colour palette has no second hue to spend, so the accent is the
 * text colour and the "selected" state is a ramp step. PLAN.md section 3:
 * one colour is the design, not a limitation to work around. */
@define-color accent_color {{ role.text | hex }};
@define-color accent_bg_color {{ ramp.a30 | hex }};
@define-color accent_fg_color {{ role.text | hex }};
@define-color theme_selected_bg_color {{ ramp.a30 | hex }};
@define-color theme_selected_fg_color {{ role.text | hex }};

/* GTK3 names the same roles differently. Both sets are defined so one file
 * can serve 3 and 4 — the unused half costs nothing. */
@define-color theme_bg_color {{ role.ground | hex }};
@define-color theme_fg_color {{ role.text | hex }};
@define-color theme_base_color {{ role.ground | hex }};
@define-color theme_text_color {{ role.text | hex }};
@define-color borders {{ role.rule | hex }};
@define-color insensitive_fg_color {{ role.text_muted | hex }};
