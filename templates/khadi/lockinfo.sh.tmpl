#!/bin/sh
# Khadi — what the lock screen is allowed to say.
#
# WHATEVER IS ON THIS SCREEN IS READABLE BY WHOEVER IS STANDING IN FRONT OF IT.
# That is the whole brief for this file. The system panel shows the IP address,
# the listening ports, the connected peers and the process list, because the
# machine is unlocked and you are the one looking at it. None of that belongs
# on a locked screen, where the reader is by definition unverified.
#
# What is left is what the owner actually wants from across the room: is it
# still up, will the battery outlive the errand, is the long download still
# running. All three are visible from the outside of the machine anyway — a
# charging LED, a blinking link light — so stating them costs nothing.
#
# Not here, deliberately: the username (half a credential), the IP address and
# SSID (both locate the machine), and anything about what was on screen.
#
# Invoked as `sh lockinfo.sh <field>`; hyprlock runs it through /bin/sh, and
# the hyprlock config stays free of shell syntax, which matters because hyprlang
# claims `$` for its own variables.

case "$1" in

uptime)
    # Same shape as khadi-hud's `dur()`: leading "0d" is noise on a machine
    # that has been up for hours, and minutes are noise on one up for days.
    secs=$(cut -d. -f1 /proc/uptime 2>/dev/null) || secs=0
    d=$((secs / 86400)); h=$((secs % 86400 / 3600)); m=$((secs % 3600 / 60))
    if   [ "$d" -gt 0 ]; then printf '%dd %dh' "$d" "$h"
    elif [ "$h" -gt 0 ]; then printf '%dh %dm' "$h" "$m"
    else                      printf '%dm' "$m"
    fi
    ;;

power)
    # A desktop reports AC and nothing else, which is the true answer rather
    # than a dash. Charging is called out because it changes what the number
    # means — 40% climbing is not 40% falling.
    bat=$(set -- /sys/class/power_supply/BAT*; echo "$1")
    if [ -r "$bat/capacity" ]; then
        cap=$(cat "$bat/capacity")
        case $(cat "$bat/status" 2>/dev/null) in
            Charging) printf 'CHARGING %s%%' "$cap" ;;
            Full)     printf 'FULL' ;;
            *)        printf '%s%%' "$cap" ;;
        esac
    else
        printf 'AC'
    fi
    ;;

net)
    # A default route, not a ping. A lock screen must not reach the network:
    # it would hang the label behind a DNS timeout, and a machine nobody is
    # sitting at should not be making requests.
    if awk 'NR > 1 && $2 == "00000000" { ok = 1 } END { exit !ok }' \
           /proc/net/route 2>/dev/null
    then printf 'ONLINE'
    else printf 'OFFLINE'
    fi
    ;;

host)
    cat /etc/hostname 2>/dev/null || printf '%s' "${HOSTNAME:-unknown}"
    ;;

*)
    echo "lockinfo.sh: want one of uptime, power, net, host" >&2
    exit 2
    ;;
esac
