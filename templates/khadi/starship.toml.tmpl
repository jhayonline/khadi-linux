# Khadi — the prompt. Derived from the theme.
#
# A/B item 13: the prompt pill with the angled edge.
#
# eDEX SHIPS NO PROMPT. The pill in screenshot_default.png is the screenshot
# author's own PS1 — there is nothing in the eDEX source to copy. So this is
# Khadi's, held to the design language rather than to a reference pixel.
#
# THE ANGLED EDGE IS DRAWABLE, which the A/B assumed it was not. U+E0B0 is
# present in Iosevka Term — measured with fontconfig, not hoped for — so the
# skew that is impossible for a tab bar in a cell grid is available for a
# one-glyph prompt terminator. The Phase 4 Iosevka subset must keep it.
#
# THE FILL IS DARKER THAN THE GROUND. The pill is a recess, not a chip: that
# is how the reference reads and it is why `role.ground_deep` exists.
#
# STARSHIP, NOT A SHELL FUNCTION. Khadi does not own the login shell, so a
# fish-only prompt would be absent for most users on the day they install.

# No modules but the path. eDEX's terminal chrome lives around the pane, not in
# the prompt, and every segment added here is a row of the shell column spent
# on something khadi-hud already shows.
format = "$directory "

[directory]
# `~/.c/eDEX-UI` — the leaf in full, every ancestor at one character. That is
# fish's abbreviation and it is exactly what the reference shows.
truncation_length = 1
truncation_symbol = ""
fish_style_pwd_dir_length = 1
truncate_to_repo = false
style = "fg:{{ role.text | hex }} bg:{{ role.ground_deep | hex }}"
format = "[ $path ]($style)[](fg:{{ role.ground_deep | hex }})"

# No symbol: the block cursor is the prompt, as it is in the reference.
[character]
success_symbol = ""
error_symbol = ""
