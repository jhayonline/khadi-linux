# Khadi — helix config. Phase 1.
theme = "khadi"

[editor]
line-number = "relative"
mouse = false                 # keyboard-driven; the mouse is not the point
bufferline = "multiple"
color-modes = true
cursorline = true
rulers = [80, 100]
true-color = true

[editor.statusline]
left   = ["mode", "spinner", "file-name", "read-only-indicator", "file-modification-indicator"]
center = []
right  = ["diagnostics", "position", "file-encoding", "file-type"]
mode.normal = "NORMAL"
mode.insert = "INSERT"
mode.select = "SELECT"

[editor.cursor-shape]
normal = "block"
insert = "bar"
select = "underline"

[editor.indent-guides]
render = true
character = "\u2502"          # the same hairline used everywhere else

[editor.file-picker]
hidden = false

[editor.soft-wrap]
enable = true
