/* Khadi — waybar. Derived from themes/tron.toml.
 * PLACEHOLDER until khadi-hud panel (Phase 3b).
 *
 * Waybar's defaults are a riot of hues — green, blue, purple pills — which is
 * exactly wrong for a one-colour design. Everything here is the accent walked
 * down the flattened alpha ramp, with the eDEX motifs applied: a hairline
 * bottom rule at 0.3 alpha, uppercase labels, letter-spacing.
 */

* {
    font-family: "{{ font.ui }}", "{{ font.mono }}", monospace;
    font-size: 12px;
    border: none;
    border-radius: 0;          /* eDEX has no rounded anything */
    min-height: 0;
}

window#waybar {
    background: {{ role.ground | hex }};
    color: {{ role.text | hex }};
    /* The hairline. The single most important rule in the design. */
    border-bottom: 1px solid {{ role.rule | hex }};
}

#custom-panel, #custom-system {
    color: {{ role.text_dim | hex }};
    letter-spacing: 1px;
    padding: 0 12px;
}

#clock {
    color: {{ role.text | hex }};
    font-weight: 600;
    letter-spacing: 2px;
    padding: 0 16px;
}

#cpu, #memory, #network, #battery {
    color: {{ role.text | hex }};
    letter-spacing: 1px;
    padding: 0 10px;
    /* Bracket ticks are a CSS pseudo-element in eDEX; GTK CSS has no
     * ::before on these widgets, so separation is a hairline instead. */
    border-left: 1px solid {{ role.rule | hex }};
}

#workspaces button {
    color: {{ role.text_muted | hex }};
    padding: 0 8px;
    background: transparent;
}
#workspaces button.active {
    color: {{ role.text | hex }};
    border-bottom: 2px solid {{ role.text | hex }};
}
#workspaces button:hover {
    background: {{ role.rule_faint | hex }};
    color: {{ role.text | hex }};
}

#battery.low { color: {{ ramp.a90 | hex }}; }
tooltip {
    background: {{ role.ground | hex }};
    border: 1px solid {{ role.rule | hex }};
    color: {{ role.text | hex }};
}
