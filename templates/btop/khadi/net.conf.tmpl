# Khadi — btop net pane.
#
# Only the net box. The system column is khadi-hud now; btop keeps the
# network panel until khadi-hud grows one (the rest of Phase 3a). HAND-BUILT, Phase 0.
# Box selection is constrained by btop's hard minimum widths, measured:
#   cpu 60  |  proc 44  |  mem 36  |  net 36  |  cpu+mem 60  |  all four 80
color_theme = "khadi"
theme_background = True
truecolor = True
shown_boxes = "net"
update_ms = 1000
graph_symbol = "block"
rounded_corners = False
proc_sorting = "cpu lazy"
show_uptime = True
check_temp = True
