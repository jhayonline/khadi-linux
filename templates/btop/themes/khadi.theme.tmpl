# Khadi — btop theme. GENERATED by khadi-theme; edit templates/, not this.
#
# Named for the product, not the theme: only one theme is active at a time and
# its identity lives in config/khadi/theme.toml. A filename like
# khadi-tron.theme would be a lie the moment another theme is built.
# One-colour design: every gradient is the accent walked down the alpha ramp,
# so btop never introduces a hue the rest of the system does not have.
theme[main_bg]="{{ role.ground | hex }}"
theme[main_fg]="{{ role.text | hex }}"
theme[title]="{{ role.text | hex }}"
theme[hi_fg]="{{ role.text_dim | hex }}"
theme[selected_bg]="{{ role.rule | hex }}"
theme[selected_fg]="{{ role.text | hex }}"
theme[inactive_fg]="{{ role.text_muted | hex }}"
theme[graph_text]="{{ role.text_dim | hex }}"
theme[meter_bg]="{{ role.rule_faint | hex }}"
theme[proc_misc]="{{ role.text_dim | hex }}"
# Box borders at rule alpha — the 0.3 that carries the whole design.
theme[cpu_box]="{{ role.rule | hex }}"
theme[mem_box]="{{ role.rule | hex }}"
theme[net_box]="{{ role.rule | hex }}"
theme[proc_box]="{{ role.rule | hex }}"
theme[div_line]="{{ role.rule | hex }}"
theme[temp_start]="{{ ramp.a40 | hex }}"
theme[temp_mid]="{{ ramp.a70 | hex }}"
theme[temp_end]="{{ role.text | hex }}"
theme[cpu_start]="{{ ramp.a40 | hex }}"
