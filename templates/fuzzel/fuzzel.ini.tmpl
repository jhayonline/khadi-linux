# Khadi — fuzzel config. Derived from themes/tron.toml.
# Phase 2 generates this file. Schema: fuzzel 1.15.0 fuzzel.ini.
# Colours are RRGGBBAA.

font={{ font.ui }}:size=11
dpi-aware=auto
prompt="> "
icons-enabled=no
terminal=foot -e
layer=overlay
anchor=center
lines=12
width=46
horizontal-pad=20
vertical-pad=12
inner-pad=6
line-height=20
# eDEX letter-spaces its UI labels (chrome.letter_spacing).
letter-spacing=1
exit-on-keyboard-focus-loss=yes

[colors]
background={{ role.ground | rgba }}
text={{ role.text_dim | rgba }}
prompt={{ role.text | rgba }}
placeholder={{ role.text_muted | rgba }}
input={{ role.text | rgba }}
match={{ role.text | rgba }}
selection={{ role.rule | rgba }}
selection-text={{ role.text | rgba }}
selection-match={{ role.text | rgba }}
counter={{ role.text_muted | rgba }}
border={{ role.rule | rgba }}

[border]
# eDEX has no rounded anything, and its rules are hairlines.
width=1
radius=0

[key-bindings]
# The keyboard model gives Alt to zellij, so nothing here uses Mod1. fuzzel is
# a transient overlay and zellij is not focused while it is up, but keeping the
# rule absolute means no one has to reason about the exception.
cancel=Escape Control+c
execute=Return KP_Enter
prev=Up Control+p
next=Down Control+n
delete-prev=BackSpace
delete-line-backward=Control+u
