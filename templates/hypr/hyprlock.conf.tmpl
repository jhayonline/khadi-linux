# Khadi — hyprlock. The lock screen.
#
# THEMED, NOT REPLACED. khadi-greet exists because nothing off the shelf could
# draw the design language on a login screen. A lock screen is a different
# calculation: it is the thing standing between a locked machine and its data,
# hyprlock is purpose-built for ext-session-lock-v1 and handles the protocol's
# failure modes, and PLAN.md section 12 says to resist every feature that moves
# work from upstream to Khadi. That applies hardest here.
#
# So this is a config, and hyprlock turns out to be able to carry the motifs:
# it renders labels through pango with a real font, so the ticked hairline is
# just text — the same trick the TUI uses, and the one the boot splash could
# NOT use because an initramfs has no pango (PLAN.md section 10m).

$font = {{ font.mono }}

general {
    hide_cursor = true
}

animations {
    # eDEX does not fade. It also means the lock appears the instant the key is
    # pressed, which is the one place where a pretty transition is a liability.
    enabled = false
}

background {
    monitor =
    # Flat ground, not a blurred screenshot of the desktop. A blur is a
    # different design language, and it also leaves a readable impression of
    # whatever was on screen when you walked away.
    color = rgba({{ role.ground | bare }}ff)
}

# The corner label pair, as every Khadi panel has.
label {
    monitor =
    text = KHADI
    color = rgba({{ role.text | bare }}ff)
    font_size = 14
    font_family = $font
    position = 24, -20
    halign = left
    valign = top
}

label {
    monitor =
    text = LOCKED
    color = rgba({{ role.text_dim | bare }}ff)
    font_size = 14
    font_family = $font
    position = -24, -20
    halign = right
    valign = top
}

# The clock. NOT the block digits the panel and the greeter use, and that is a
# measured decision rather than an oversight.
#
# Those are drawn one glyph per pixel, which works where a cell is exactly as
# wide as half its height — a terminal grid, and the VT the greeter runs on.
# hyprlock renders through pango, which adds leading between lines and exposes
# no way to remove it, so every pixel becomes a wide rectangle with a gap under
# it and the digits come out as crude bars. Doubling the width to compensate
# only trades one distortion for another; it was tried and photographed.
#
# A large $TIME in the same face is clean, and the surface is still
# unmistakably Khadi from the ground, the rule, the corner pair and the font.
label {
    monitor =
    text = $TIME
    color = rgba({{ role.text | bare }}ff)
    font_size = 96
    font_family = $font
    position = 0, 150
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:60000] date +"%a %d %b %Y" | tr a-z A-Z
    color = rgba({{ role.text_muted | bare }}ff)
    font_size = 13
    font_family = $font
    position = 0, 20
    halign = center
    valign = center
}

# The motif. Text, not a shape: hyprlock has pango and the font has the glyph,
# so the hairline and its ticks are the same characters khadi-hud draws.
label {
    monitor =
    text = ┬──────────────────────────────────────┬
    color = rgba({{ role.rule | bare }}ff)
    font_size = 13
    font_family = $font
    position = 0, -20
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 380, 42
    # No rounding and a hairline outline: eDEX has no rounded anything and no
    # shadows, and softening either reads as a different design language.
    rounding = 0
    outline_thickness = 1
    inner_color = rgba({{ role.ground | bare }}ff)
    outer_color = rgba({{ role.rule | bare }}ff)
    check_color = rgba({{ ramp.a60 | bare }}ff)
    fail_color = rgba({{ role.text_muted | bare }}ff)
    font_color = rgba({{ role.text | bare }}ff)
    font_family = $font
    placeholder_text = PASSWORD
    fail_text = $PAMFAIL
    # The password as its length and nothing else, in the same block the
    # greeter uses.
    dots_text_format = █
    dots_size = 0.25
    dots_spacing = 0.3
    fade_on_empty = false
    position = 0, -80
    halign = center
    valign = center
}
