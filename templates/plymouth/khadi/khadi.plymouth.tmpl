# Khadi — Plymouth boot theme.
#
# The first thing anyone sees, and the only part of the aesthetic that runs
# before a compositor exists. PLAN.md section 8: "first impression starts
# here, not after reboot."

[Plymouth Theme]
Name=Khadi
Description=Terminal-first boot. Real systemd units, not a fake log.
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/khadi
ScriptFile=/usr/share/plymouth/themes/khadi/khadi.script
# Shown if the splash is dropped for the plain console log.
ConsoleLogBackgroundColor=0x{{ role.ground | bare }}
# Both are the mono face: the splash is a terminal, not a dialog. The hook
# feeds these names to fc-match on the host to decide which file to bake in,
# and plymouth resolves Image.Text against the result — so the SIZE lives here
# rather than in the script.
MonospaceFont={{ font.mono }} 14
Font={{ font.mono }} 14
