# Khadi — Plymouth boot splash.
#
# The first thing anyone sees, and the only part of the aesthetic that runs
# before a compositor exists.
#
# eDEX'S BOOT SCREEN IS A FAKE LOG: 85 lines of invented macOS kernel messages
# in assets/misc/boot_log.txt, replayed with a delay and a sound per line. It
# even opens "Welcome to eDEX-UI!" and talks about kexts. Khadi shows the real
# ones instead — systemd feeds plymouth genuine unit status through
# SetUpdateStatusFunction, so the scrolling log costs nothing to make true, and
# a desktop whose whole pitch is "measured, not assumed" should not open with
# theatre.
#
# EVERYTHING HERE IS TEXT. Plymouth script has no rectangle primitive, so most
# themes ship PNGs for their bars and rules. Khadi's chrome is characters, so
# the splash needs no image assets at all and restyles from the theme file like
# every other config.
#
# ASCII, NOT THE BOX-DRAWING MOTIF, and this was measured rather than chosen.
# The rule everywhere else in Khadi is "┬───┬"; here it is "+---+". An
# initramfs carries only `label-freetype.so` — plymouth's minimal text renderer
# — because `label-pango.so` would drag in pango, harfbuzz and fontconfig. That
# renderer draws Latin correctly and returns .notdef for everything multi-byte,
# so the first working version came up with "KHADI" and "BOOT" in the right
# face above a rule of tofu boxes. The font was never the problem: Iosevka Term
# is correctly baked in and does carry U+2500.
#
# The fix if the motif matters more than the simplicity: generate the rule as a
# small PNG at theme-build time and Scale() it. That trades a pure-text theme
# for a PNG writer in khadi-theme, and it is not obviously worth it for the
# four seconds this is on screen.

Window.SetBackgroundTopColor({{ role.ground | rgbf }});
Window.SetBackgroundBottomColor({{ role.ground | rgbf }});

global.cols = 68;
global.rows = 12;
global.lead = 24;

# NO EXPLICIT FONT ARGUMENT, and this is the whole reason the first version
# rendered a black screen.
#
# Image.Text takes a font string, and passing "{{ font.mono }} 13" works fine
# on a running system. Inside an initramfs it cannot: mkinitcpio's plymouth
# hook resolves the theme's font with fc-match ON THE HOST and copies the file
# in as /usr/share/fonts/Plymouth-monospace.ttf — renamed, with no fontconfig
# in there to look up a family by name. So the name resolves to nothing, every
# label comes back empty, and the splash is a black screen with no error
# anywhere. Omitting the argument uses the theme's configured font, which is
# the one plymouth actually copied. Size is set in khadi.plymouth.
fun text(s, r, g, b) {
    return Image.Text(s, r, g, b);
}

# The rule, built once. ASCII for the reason in the header.
fun make_rule(ch, cap) {
    s = cap;
    for (i = 0; i < global.cols - 2; i++) {
        s = s + ch;
    }
    return s + cap;
}
global.rule_img = text(make_rule("-", "+"), {{ role.rule | rgbf }});

# Everything is laid out against the rule's own width, so the block stays
# coherent whatever the screen is.
global.left  = Window.GetWidth()  / 2 - global.rule_img.GetWidth() / 2;
global.width = global.rule_img.GetWidth();
global.top   = Window.GetHeight() / 2 - (global.rows + 6) * global.lead / 2;

# --- header: label pair over the rule --------------------------------------
head_l = text("KHADI", {{ role.text | rgbf }});
head_r = text("BOOT", {{ role.text_dim | rgbf }});
global.head_l_sprite = Sprite(head_l);
global.head_l_sprite.SetPosition(global.left, global.top, 10);
global.head_r_sprite = Sprite(head_r);
global.head_r_sprite.SetPosition(global.left + global.width - head_r.GetWidth(), global.top, 10);
global.rule_sprite = Sprite(global.rule_img);
global.rule_sprite.SetPosition(global.left, global.top + global.lead, 10);

# --- the log ---------------------------------------------------------------
global.body = global.top + global.lead * 3;
global.log = [];
global.log_sprite = [];
for (i = 0; i < global.rows; i++) {
    global.log[i] = "";
    global.log_sprite[i] = Sprite();
    global.log_sprite[i].SetPosition(global.left, global.body + i * global.lead, 10);
    global.log_sprite[i].SetOpacity(0);
}

fun redraw_log() {
    for (i = 0; i < global.rows; i++) {
        if (global.log[i] == "") {
            global.log_sprite[i].SetOpacity(0);
        } else {
            # Newest bright, the rest muted. The same depth cue the globe uses:
            # it reads as a log running forward rather than a block of text.
            if (i == global.rows - 1) {
                img = text(global.log[i], {{ role.text | rgbf }});
            } else {
                img = text(global.log[i], {{ role.text_muted | rgbf }});
            }
            global.log_sprite[i].SetImage(img);
            global.log_sprite[i].SetOpacity(1);
        }
    }
}

fun push(line) {
    for (i = 0; i < global.rows - 1; i++) {
        global.log[i] = global.log[i + 1];
    }
    global.log[global.rows - 1] = line;
    redraw_log();
}

fun status_callback(status) {
    push(status);
}
Plymouth.SetUpdateStatusFunction(status_callback);

fun message_callback(msg) {
    push(msg);
}
Plymouth.SetDisplayMessageFunction(message_callback);

# --- progress --------------------------------------------------------------
global.bar_y = global.body + global.rows * global.lead + global.lead;
global.bar_sprite = Sprite();
global.bar_sprite.SetPosition(global.left, global.bar_y, 10);
global.max_progress = 0.0;

fun draw_progress(p) {
    if (p <= global.max_progress) return;
    global.max_progress = p;
    n = Math.Int(p * global.cols);
    s = "";
    for (i = 0; i < global.cols; i++) {
        if (i < n) {
            s = s + "#";
        } else {
            s = s + ".";
        }
    }
    global.bar_sprite.SetImage(text(s, {{ ramp.a60 | rgbf }}));
    global.bar_sprite.SetOpacity(1);
}

fun progress_callback(duration, progress) {
    draw_progress(progress);
}
Plymouth.SetBootProgressFunction(progress_callback);

# --- the disk password -----------------------------------------------------
# LUKS is on by default (PLAN.md section 8), so for an encrypted install this
# is the first thing typed on a Khadi machine — before the greeter, before the
# compositor. It gets the same label pair and the same rule as everything else.
global.prompt_sprite = Sprite();
global.prompt_sprite.SetPosition(global.left, global.body + global.lead, 20);
global.prompt_sprite.SetOpacity(0);
global.bullet_sprite = Sprite();
global.bullet_sprite.SetPosition(global.left, global.body + global.lead * 3, 20);
global.bullet_sprite.SetOpacity(0);

fun hide_log() {
    for (i = 0; i < global.rows; i++) {
        global.log_sprite[i].SetOpacity(0);
    }
}

fun password_callback(prompt, bullets) {
    hide_log();
    global.head_r_sprite.SetImage(text("UNLOCK", {{ role.text | rgbf }}));
    global.prompt_sprite.SetImage(text(prompt, {{ role.text_dim | rgbf }}));
    global.prompt_sprite.SetOpacity(1);

    s = "";
    for (i = 0; i < bullets; i++) {
        s = s + "*";
    }
    global.bullet_sprite.SetImage(text(s, {{ role.text | rgbf }}));
    global.bullet_sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(password_callback);

fun normal_callback() {
    global.head_r_sprite.SetImage(text("BOOT", {{ role.text_dim | rgbf }}));
    global.prompt_sprite.SetOpacity(0);
    global.bullet_sprite.SetOpacity(0);
    redraw_log();
}
Plymouth.SetDisplayNormalFunction(normal_callback);

fun quit_callback() {
    hide_log();
    global.bar_sprite.SetOpacity(0);
}
Plymouth.SetQuitFunction(quit_callback);
