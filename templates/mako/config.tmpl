# Khadi — mako notifications. Derived from themes/tron.toml.
# Phase 2 generates this file. Colours are #RRGGBBAA.

font={{ font.ui }} 11
background-color={{ role.ground | hrgba }}
text-color={{ role.text | hrgba }}
border-color={{ role.rule | hrgba }}
progress-color=over {{ role.rule | hrgba }}

# eDEX has no rounded anything and its rules are hairlines (chrome, section 3).
border-size=1
border-radius=0
padding=10,14
margin=8
width=380
height=120
max-visible=4
default-timeout=6000
icons=0
markup=1
format=<b>%s</b>\n%b
layer=overlay
anchor=top-right

[urgency=low]
text-color={{ role.text_muted | hrgba }}
border-color={{ role.rule_faint | hrgba }}

[urgency=critical]
text-color={{ role.text | hrgba }}
border-color={{ ramp.a90 | hrgba }}
default-timeout=0
