# Khadi — yazi config. Phase 1.
# Behaviour only; colours live in theme.toml.

[mgr]
ratio          = [1, 3, 4]
sort_by        = "natural"
sort_sensitive = false
sort_reverse   = false
sort_dir_first = true
linemode       = "size"
show_hidden    = false
show_symlink   = true
scrolloff      = 5

[preview]
wrap        = "no"
tab_size    = 4
max_width   = 600
max_height  = 900
image_filter = "triangle"
image_quality = 75
